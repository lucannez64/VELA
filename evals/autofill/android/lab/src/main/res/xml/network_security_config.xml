<?xml version="1.0" encoding="utf-8"?>
<!-- Eval-only app: plain HTTP to the eval server, and the eval CA (installed
     as a user certificate) for the fixture sites in the WebView. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
