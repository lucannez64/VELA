theory M7_OneShotAssertion

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Vault_Setup:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred, $O ), Registered( $O, pk(~cred) ) ]->
   [ !Vault( ~cred, $O ), !RpKey( $O, pk(~cred) ), Out( pk(~cred) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_User_Presence:
   [ Fr( ~up ) ] --[ UserPresent( $O, ~up ) ]-> [ UserPresence( $O, ~up ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_Assertion:
   [ !Vault( cred, $O ), UserPresence( $O, up ), In( <'auth', $O, chal> ) ]
  --[
  Asserted( $O, chal ), AssertedWith( $O, chal, up ), AuthUsed( cred, $O )
  ]->
   [ Out( sign(<$O, chal>, cred) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Challenge:
   [ Fr( ~chal ) ]
  --[ Challenge( $O, ~chal ) ]->
   [ Out( <$O, ~chal> ), StRP( $O, ~chal ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Accept:
   [ StRP( O, chal ), !RpKey( O, pkey ), In( sig ) ]
  --[ Accept( O, chal ), Verified( verify(sig, <O, chal>, pkey) ) ]->
   [ ]

  /*
  rule (modulo AC) RP_Accept:
     [ StRP( O, chal ), !RpKey( O, pkey ), In( sig ) ]
    --[ Accept( O, chal ), Verified( z ) ]->
     [ ]
    variants (modulo AC)
    1. O     = O.6
       chal  = chal.6
       pkey  = pkey.6
       sig   = sig.6
       z     = verify(sig.6, <O.6, chal.6>, pkey.6)
    
    2. O     = x.6
       chal  = x.7
       pkey  = pk(x.8)
       sig   = sign(<x.6, x.7>, x.8)
       z     = true
  */

restriction VerifyTrue:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  */

lemma credential_never_leaks:
  all-traces "∀ c O #i. (Secret( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (Secret( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
by solve( !KU( ~cred ) @ #vk )

lemma used_passkey_item_still_secret:
  all-traces "∀ c O #i. (AuthUsed( c, O ) @ #i) ⇒ (¬(∃ #k. K( c ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (AuthUsed( c, O ) @ #i) ∧ ∃ #k. (K( c ) @ #k)"
*/
simplify
solve( !Vault( c, $O ) ▶₀ #i )
  case Vault_Setup
  solve( UserPresence( $O, up ) ▶₁ #i )
    case Human_User_Presence
    by solve( !KU( ~cred ) @ #vk.5 )
  qed
qed

lemma assertion_requires_user_presence:
  all-traces
  "∀ O chal #i.
    (Asserted( O, chal ) @ #i) ⇒
    (∃ up #j. (UserPresent( O, up ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ O chal #i.
  (Asserted( O, chal ) @ #i)
 ∧
  ∀ up #j. (UserPresent( O, up ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !Vault( cred, $O ) ▶₀ #i )
  case Vault_Setup
  solve( UserPresence( $O, up ) ▶₁ #i )
    case Human_User_Presence
    by contradiction /* from formulas */
  qed
qed

lemma assertions_bounded_by_presence:
  all-traces
  "∀ O c1 c2 up #i #j.
    ((AssertedWith( O, c1, up ) @ #i) ∧ (AssertedWith( O, c2, up ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ O c1 c2 up #i #j.
  (AssertedWith( O, c1, up ) @ #i) ∧ (AssertedWith( O, c2, up ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !Vault( cred, $O ) ▶₀ #i )
    case Vault_Setup
    solve( UserPresence( $O, up ) ▶₁ #i )
      case Human_User_Presence
      solve( !Vault( cred.1, $O ) ▶₀ #j )
        case Vault_Setup
        solve( UserPresence( $O, ~up ) ▶₁ #j )
          case Human_User_Presence
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !Vault( cred, $O ) ▶₀ #i )
    case Vault_Setup
    solve( UserPresence( $O, up ) ▶₁ #i )
      case Human_User_Presence
      solve( !Vault( cred.1, $O ) ▶₀ #j )
        case Vault_Setup
        solve( UserPresence( $O, ~up ) ▶₁ #j )
          case Human_User_Presence
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma assertion_is_origin_bound:
  all-traces
  "∀ O chal #i.
    (Accept( O, chal ) @ #i) ⇒
    (∃ #j. (Asserted( O, chal ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ O chal #i.
  (Accept( O, chal ) @ #i) ∧ ∀ #j. (Asserted( O, chal ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( StRP( O, chal ) ▶₀ #i )
  case RP_Challenge
  solve( !RpKey( $O, pk(x) ) ▶₁ #i )
    case Vault_Setup
    solve( !KU( sign(<$O, ~chal>, ~cred) ) @ #vk )
      case Sign_Assertion
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~cred ) @ #vk.2 )
    qed
  qed
qed

lemma assertion_one_shot:
  all-traces
  "∀ O chal #i #j.
    ((Accept( O, chal ) @ #i) ∧ (Accept( O, chal ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ O chal #i #j.
  (Accept( O, chal ) @ #i) ∧ (Accept( O, chal ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( StRP( O, chal ) ▶₀ #i )
    case RP_Challenge
    solve( !RpKey( $O, pk(x) ) ▶₁ #i )
      case Vault_Setup
      solve( StRP( $O, ~chal ) ▶₀ #j )
        case RP_Challenge
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case case_2
  solve( StRP( O, chal ) ▶₀ #i )
    case RP_Challenge
    solve( !RpKey( $O, pk(x) ) ▶₁ #i )
      case Vault_Setup
      solve( StRP( $O, ~chal ) ▶₀ #j )
        case RP_Challenge
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma transient_residual:
  exists-trace "∃ O chal #i. Accept( O, chal ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ O chal #i. (Accept( O, chal ) @ #i)"
*/
simplify
solve( StRP( O, chal ) ▶₀ #i )
  case RP_Challenge
  solve( !RpKey( $O, pk(x) ) ▶₁ #i )
    case Vault_Setup
    solve( !KU( sign(<$O, ~chal>, ~cred) ) @ #vk )
      case Sign_Assertion
      solve( !KU( ~chal ) @ #vk.5 )
        case RP_Challenge
        SOLVED // trace found
      qed
    qed
  qed
qed

