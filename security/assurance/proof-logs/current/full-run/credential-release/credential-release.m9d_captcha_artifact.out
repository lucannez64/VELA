theory M9d_CaptchaArtifactLogin

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred, $O ) ]->
   [ !Vault( ~cred, $O ), !SiteStore( ~cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve_Login:
   [ !Vault( cred, $O ), Fr( ~g ) ]
  --[ LoginApproved( cred, $O ) ]->
   [ LoginGrant( cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Solves_Captcha:
   [ Fr( ~tok ) ]
  --[ CaptchaSolved( $O, ~tok ) ]->
   [ Out( <'captcha', $O, ~tok> ), CaptchaToken( $O, ~tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Extension_Lifts_Token:
   [ CaptchaToken( $O, tok ) ]
  --[ TokenLifted( $O, tok ) ]->
   [ TokenAtCore( $O, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Desktop_Login_With_Artifact:
   [
   !Vault( cred, $O ), LoginGrant( cred, $O ), TokenAtCore( $O, tok ),
   In( <'jar', $O> )
   ]
  --[ LoginPerformedWithArtifact( cred, $O, tok ) ]->
   [ CredToSite( cred, $O, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_CheckAndIssue:
   [ !SiteStore( cred, O ), CredToSite( cred, O, tok ), Fr( ~sid ) ]
  --[ SessionIssued( O, ~sid, tok ), LoginOk( cred, O ) ]->
   [ Out( <'session', O, ~sid> ) ]

  /* has exactly the trivial AC variant */

lemma credential_never_leaks:
  all-traces "∀ c O #i. (Secret( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (Secret( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
by solve( !KU( ~cred ) @ #vk )

lemma used_item_still_secret:
  all-traces "∀ c O #i. (LoginOk( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (LoginOk( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( !SiteStore( c, O ) ▶₀ #i )
  case Setup
  solve( CredToSite( ~cred, $O, tok ) ▶₁ #i )
    case Desktop_Login_With_Artifact
    by solve( !KU( ~cred ) @ #vk )
  qed
qed

lemma every_session_goes_through_the_vault:
  all-traces
  "∀ O sid t #i.
    (SessionIssued( O, sid, t ) @ #i) ⇒ (∃ c #j. LoginApproved( c, O ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ O sid t #i.
  (SessionIssued( O, sid, t ) @ #i)
 ∧
  ∀ c #j. (LoginApproved( c, O ) @ #j) ⇒ ⊥"
*/
simplify
solve( !SiteStore( cred, O ) ▶₀ #i )
  case Setup
  solve( CredToSite( ~cred, $O, t ) ▶₁ #i )
    case Desktop_Login_With_Artifact
    by contradiction /* from formulas */
  qed
qed

lemma a_lifted_token_logs_in_once:
  all-traces
  "∀ c1 c2 O t #i #j.
    ((LoginPerformedWithArtifact( c1, O, t ) @ #i) ∧
     (LoginPerformedWithArtifact( c2, O, t ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ c1 c2 O t #i #j.
  (LoginPerformedWithArtifact( c1, O, t ) @ #i) ∧
  (LoginPerformedWithArtifact( c2, O, t ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !Vault( c1, $O ) ▶₀ #i )
    case Setup
    solve( LoginGrant( ~cred, $O ) ▶₁ #i )
      case Human_Approve_Login
      solve( TokenAtCore( $O, t ) ▶₂ #i )
        case Extension_Lifts_Token
        solve( !Vault( c2, $O ) ▶₀ #j )
          case Setup
          solve( LoginGrant( ~cred.1, $O ) ▶₁ #j )
            case Human_Approve_Login
            solve( TokenAtCore( $O, ~tok ) ▶₂ #j )
              case Extension_Lifts_Token
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !Vault( c1, $O ) ▶₀ #i )
    case Setup
    solve( LoginGrant( ~cred, $O ) ▶₁ #i )
      case Human_Approve_Login
      solve( TokenAtCore( $O, t ) ▶₂ #i )
        case Extension_Lifts_Token
        solve( !Vault( c2, $O ) ▶₀ #j )
          case Setup
          solve( LoginGrant( ~cred.1, $O ) ▶₁ #j )
            case Human_Approve_Login
            solve( TokenAtCore( $O, ~tok ) ▶₂ #j )
              case Extension_Lifts_Token
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma artifact_is_adversary_observable:
  exists-trace "∃ O t #i. K( <'captcha', O, t> ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ O t #i. (K( <'captcha', O, t> ) @ #i)"
*/
simplify
SOLVED // trace found

lemma login_succeeds:
  exists-trace
  "∃ O sid c #i #j #k.
    ((LoginOk( c, O ) @ #i) ∧ (K( <'session', O, sid> ) @ #j)) ∧
    (LoginApproved( c, O ) @ #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ O sid c #i #j #k.
  (LoginOk( c, O ) @ #i) ∧
  (K( <'session', O, sid> ) @ #j) ∧
  (LoginApproved( c, O ) @ #k)"
*/
simplify
solve( !SiteStore( c, $O ) ▶₀ #i )
  case Setup
  solve( CredToSite( ~cred, $O, tok ) ▶₁ #i )
    case Desktop_Login_With_Artifact
    solve( !Vault( ~cred, $O ) ▶₀ #k )
      case Setup
      SOLVED // trace found
    qed
  qed
qed

