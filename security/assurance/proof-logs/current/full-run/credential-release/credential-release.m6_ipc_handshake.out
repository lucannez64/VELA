theory M6_IpcHandshake

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Desktop_Listen:
   [ ] --[ DesktopListening( ) ]-> [ !Listening( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Spawn_Host:
   [ !Listening( ) ] --[ BrowserSpawned( $C ) ]-> [ Spawned( $C ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromised_Browser_Spawn:
   [ !Listening( ) ] --[ CompromisedBrowser( $C ) ]-> [ Spawned( $C ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Connect:
   [ Spawned( $C ), !Listening( ) ]
  --[ HostConnected( $C ) ]->
   [ Talking( $C ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Vault_Setup:
   [ Fr( ~cred ) ] --[ Secret( ~cred, $O ) ]-> [ !Vault( ~cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Join:
   [ Fr( ~sk ) ]
  --[ Joined( $C, pk(~sk) ), SecretClientKey( $C, ~sk ) ]->
   [
   !MyKey( $C, pk(~sk), ~sk ), !OnScreen( $C, pk(~sk) ),
   Out( <'join', $C, pk(~sk)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Confirm_Pairing:
   [ !OnScreen( $C, pkey ) ]
  --[ HumanPairConfirmed( $C, h(pkey) ) ]->
   [ Confirmed( $C, pkey ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Desktop_Enroll:
   [ In( <'join', $C, pkey> ), Confirmed( $C, pkey ) ]
  --[ Enrolled( $C, pkey ) ]->
   [ !ClientKey( $C, pkey ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Request:
   [ !MyKey( $C, pkey, sk ), Fr( ~r ) ]
  --[ ClientRequests( $C, $O, ~r ) ]->
   [ Out( <'fill', $C, $O, ~r, sign(<'fill', $C, $O, ~r>, sk)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve:
   [ !Vault( cred, $O ), Fr( ~g ) ]
  --[ Issue( $C, $O, cred, ~g ) ]->
   [ Grant( $C, $O, cred, ~g ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Desktop_Release:
   [
   Grant( $C, $O, cred, g ), !ClientKey( $C, pkey ), !Vault( cred, $O ),
   Talking( $C ), In( <'fill', $C, $O, r, sig> )
   ]
  --[
  Released( $C, $O, cred, g, r ), RequestUsed( r ),
  Verified( verify(sig, <'fill', $C, $O, r>, pkey) )
  ]->
   [ Out( cred ) ]

  /*
  rule (modulo AC) Desktop_Release:
     [
     Grant( $C, $O, cred, g ), !ClientKey( $C, pkey ), !Vault( cred, $O ),
     Talking( $C ), In( <'fill', $C, $O, r, sig> )
     ]
    --[ Released( $C, $O, cred, g, r ), RequestUsed( r ), Verified( z ) ]->
     [ Out( cred ) ]
    variants (modulo AC)
    1. $C    = $C.11
       $O    = $O.12
       pkey  = pkey.15
       r     = r.16
       sig   = sig.17
       z     = verify(sig.17, <'fill', $C.11, $O.12, r.16>, pkey.15)
    
    2. $C    = $C.16
       $O    = $O.17
       pkey  = pk(x.29)
       r     = r.21
       sig   = sign(<'fill', $C.16, $O.17, r.21>, x.29)
       z     = true
  */

rule (modulo E) Grant_Expire:
   [ Grant( $C, $O, cred, g ) ] --[ Expired( $C, $O, cred, g ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Grant_Revoke:
   [ Grant( $C, $O, cred, g ) ] --[ Revoked( $C, $O, cred, g ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Corrupt_Client:
   [ !MyKey( $C, pkey, sk ) ] --[ Compromised( $C ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

restriction VerifyTrue:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  */

restriction RequestNonceIsFresh:
  "∀ r #i #j.
    ((RequestUsed( r ) @ #i) ∧ (RequestUsed( r ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ r #i #j.
    ((RequestUsed( r ) @ #i) ∧ (RequestUsed( r ) @ #j)) ⇒ (#i = #j)"
  */

lemma client_key_secret_unless_compromised:
  all-traces
  "∀ C sk #i #j.
    ((SecretClientKey( C, sk ) @ #i) ∧ (K( sk ) @ #j)) ⇒
    (∃ #h. (Compromised( C ) @ #h) ∧ (#h < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C sk #i #j.
  (SecretClientKey( C, sk ) @ #i) ∧ (K( sk ) @ #j)
 ∧
  ∀ #h. (Compromised( C ) @ #h) ⇒ ¬(#h < #j)"
*/
simplify
solve( !KU( ~sk ) @ #vk )
  case Corrupt_Client
  by contradiction /* from formulas */
qed

