lemma grant_is_single_use:
  all-traces
  "∀ C O c g r1 r2 #i #j.
    ((Released( C, O, c, g, r1 ) @ #i) ∧ (Released( C, O, c, g, r2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ C O c g r1 r2 #i #j.
  (Released( C, O, c, g, r1 ) @ #i) ∧ (Released( C, O, c, g, r2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Grant( $C, $O, c, g ) ▶₀ #i )
    case Human_Approve
    solve( !ClientKey( $C, pk(x) ) ▶₁ #i )
      case Desktop_Enroll
      solve( !Vault( ~cred, $O ) ▶₂ #i )
        case Vault_Setup
        solve( Talking( $C ) ▶₃ #i )
          case Host_Connect_case_1
          solve( Grant( $C, $O, ~cred, ~g ) ▶₀ #j )
            case Human_Approve
            by contradiction /* cyclic */
          qed
        next
          case Host_Connect_case_2
          solve( Grant( $C, $O, ~cred, ~g ) ▶₀ #j )
            case Human_Approve
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( Grant( $C, $O, c, g ) ▶₀ #i )
    case Human_Approve
    solve( !ClientKey( $C, pk(x) ) ▶₁ #i )
      case Desktop_Enroll
      solve( !Vault( ~cred, $O ) ▶₂ #i )
        case Vault_Setup
        solve( Talking( $C ) ▶₃ #i )
          case Host_Connect_case_1
          solve( Grant( $C, $O, ~cred, ~g ) ▶₀ #j )
            case Human_Approve
            by contradiction /* cyclic */
          qed
        next
          case Host_Connect_case_2
          solve( Grant( $C, $O, ~cred, ~g ) ▶₀ #j )
            case Human_Approve
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
qed

