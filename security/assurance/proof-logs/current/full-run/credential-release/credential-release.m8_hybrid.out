lemma assertions_bounded_by_presence:
  all-traces
  "∀ O c1 c2 up #i #j.
    ((AssertedWith( O, c1, up ) @ #i) ∧ (AssertedWith( O, c2, up ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ O c1 c2 up #i #j.
  (AssertedWith( O, c1, up ) @ #i) ∧ (AssertedWith( O, c2, up ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( !Vault( cred, $O, 'passkey' ) ▶₀ #i )
    case Vault_Setup_Passkey
    solve( UserPresence( $O, up ) ▶₁ #i )
      case Human_User_Presence
      solve( !Vault( cred.1, $O, 'passkey' ) ▶₀ #j )
        case Vault_Setup_Passkey
        solve( UserPresence( $O, ~up ) ▶₁ #j )
          case Human_User_Presence
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( !Vault( cred, $O, 'passkey' ) ▶₀ #i )
    case Vault_Setup_Passkey
    solve( UserPresence( $O, up ) ▶₁ #i )
      case Human_User_Presence
      solve( !Vault( cred.1, $O, 'passkey' ) ▶₀ #j )
        case Vault_Setup_Passkey
        solve( UserPresence( $O, ~up ) ▶₁ #j )
          case Human_User_Presence
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

