theory M8_Hybrid

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Vault_Setup_Passkey:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred, $O, 'passkey' ), Registered( $O, pk(~cred) ) ]->
   [
   !Vault( ~cred, $O, 'passkey' ), !RpKey( $O, pk(~cred) ), Out( pk(~cred) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Vault_Setup_Legacy:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred, $O, 'legacy' ) ]->
   [ !Vault( ~cred, $O, 'legacy' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_User_Presence:
   [ Fr( ~up ) ] --[ UserPresent( $O, ~up ) ]-> [ UserPresence( $O, ~up ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_Assertion:
   [
   !Vault( cred, $O, 'passkey' ), UserPresence( $O, up ),
   In( <'auth', $O, chal> )
   ]
  --[
  Asserted( $O, chal ), AssertedWith( $O, chal, up ), AuthUsed( cred, $O )
  ]->
   [ Out( sign(<$O, chal>, cred) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Challenge:
   [ Fr( ~chal ) ]
  --[ Challenge( $O, ~chal ) ]->
   [ Out( <$O, ~chal> ), StRP( $O, ~chal ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Accept:
   [ StRP( O, chal ), !RpKey( O, pkey ), In( sig ) ]
  --[ Accept( O, chal ), Verified( verify(sig, <O, chal>, pkey) ) ]->
   [ ]

  /*
  rule (modulo AC) RP_Accept:
     [ StRP( O, chal ), !RpKey( O, pkey ), In( sig ) ]
    --[ Accept( O, chal ), Verified( z ) ]->
     [ ]
    variants (modulo AC)
    1. O     = O.6
       chal  = chal.6
       pkey  = pkey.6
       sig   = sig.6
       z     = verify(sig.6, <O.6, chal.6>, pkey.6)
    
    2. O     = x.6
       chal  = x.7
       pkey  = pk(x.8)
       sig   = sign(<x.6, x.7>, x.8)
       z     = true
  */

rule (modulo E) Client_Join:
   [ Fr( ~sk ) ]
  --[ Joined( $C, pk(~sk) ), SecretClientKey( $C, ~sk ) ]->
   [
   !MyKey( $C, pk(~sk), ~sk ), !OnScreen( $C, pk(~sk) ),
   Out( <'join', $C, pk(~sk)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Confirm_Pairing:
   [ !OnScreen( $C, pkey ) ]
  --[ HumanPairConfirmed( $C, h(pkey) ) ]->
   [ Confirmed( $C, pkey ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Desktop_Enroll:
   [ In( <'join', $C, pkey> ), Confirmed( $C, pkey ) ]
  --[ Enrolled( $C, pkey ) ]->
   [ !ClientKey( $C, pkey ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_Request:
   [ !MyKey( $C, pkey, sk ), Fr( ~r ) ]
  --[ ClientRequests( $C, $O, ~r ) ]->
   [ Out( <'fill', $C, $O, ~r, sign(<'fill', $C, $O, ~r>, sk)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve:
   [ !Vault( cred, $O, 'legacy' ), Fr( ~g ) ]
  --[ Issue( $C, $O, cred, ~g ) ]->
   [ Grant( $C, $O, cred, ~g ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Desktop_Release:
   [
   Grant( $C, $O, cred, g ), !ClientKey( $C, pkey ),
   !Vault( cred, $O, 'legacy' ), In( <'fill', $C, $O, r, sig> )
   ]
  --[
  Released( $C, $O, cred, g, r ), RequestUsed( r ),
  Verified( verify(sig, <'fill', $C, $O, r>, pkey) )
  ]->
   [ Out( cred ) ]

  /*
  rule (modulo AC) Desktop_Release:
     [
     Grant( $C, $O, cred, g ), !ClientKey( $C, pkey ),
     !Vault( cred, $O, 'legacy' ), In( <'fill', $C, $O, r, sig> )
     ]
    --[ Released( $C, $O, cred, g, r ), RequestUsed( r ), Verified( z ) ]->
     [ Out( cred ) ]
    variants (modulo AC)
    1. $C    = $C.18
       $O    = $O.19
       pkey  = pkey.22
       r     = r.23
       sig   = sig.24
       z     = verify(sig.24, <'fill', $C.18, $O.19, r.23>, pkey.22)
    
    2. $C    = $C.26
       $O    = $O.27
       pkey  = pk(x.50)
       r     = r.31
       sig   = sign(<'fill', $C.26, $O.27, r.31>, x.50)
       z     = true
  */

rule (modulo E) Grant_Expire:
   [ Grant( $C, $O, cred, g ) ] --[ Expired( $C, $O, cred, g ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Grant_Revoke:
   [ Grant( $C, $O, cred, g ) ] --[ Revoked( $C, $O, cred, g ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Corrupt_Client:
   [ !MyKey( $C, pkey, sk ) ] --[ Compromised( $C ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

restriction VerifyTrue:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  */

restriction RequestNonceIsFresh:
  "∀ r #i #j.
    ((RequestUsed( r ) @ #i) ∧ (RequestUsed( r ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ r #i #j.
    ((RequestUsed( r ) @ #i) ∧ (RequestUsed( r ) @ #j)) ⇒ (#i = #j)"
  */

lemma passkey_item_never_leaks:
  all-traces
  "∀ c O #i. (Secret( c, O, 'passkey' ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (Secret( c, O, 'passkey' ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( Secret( c, O, 'passkey' ) @ #i )
  case Vault_Setup_Passkey
  by solve( !KU( ~cred ) @ #vk )
qed

