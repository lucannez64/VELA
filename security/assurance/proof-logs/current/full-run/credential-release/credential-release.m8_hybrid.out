lemma legacy_release_requires_client_request:
  all-traces
  "∀ C O c g r #i.
    (Released( C, O, c, g, r ) @ #i) ⇒
    ((∃ #j. (Issue( C, O, c, g ) @ #j) ∧ (#j < #i)) ∧
     ((∃ #h. (ClientRequests( C, O, r ) @ #h) ∧ (#h < #i)) ∨
      (∃ #h. (Compromised( C ) @ #h) ∧ (#h < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ C O c g r #i.
  (Released( C, O, c, g, r ) @ #i)
 ∧
  ((∀ #j. (Issue( C, O, c, g ) @ #j) ⇒ ¬(#j < #i)) ∨
   ((∀ #h. (ClientRequests( C, O, r ) @ #h) ⇒ ¬(#h < #i)) ∧
    (∀ #h. (Compromised( C ) @ #h) ⇒ ¬(#h < #i))))"
*/
simplify
solve( (∀ #j. (Issue( $C, $O, c, g ) @ #j) ⇒ ¬(#j < #i))  ∥
       ((∀ #h. (ClientRequests( $C, $O, r ) @ #h) ⇒ ¬(#h < #i)) ∧
        (∀ #h. (Compromised( $C ) @ #h) ⇒ ¬(#h < #i))) )
  case case_1
  solve( Grant( $C, $O, c, g ) ▶₀ #i )
    case Human_Approve
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( Grant( $C, $O, c, g ) ▶₀ #i )
    case Human_Approve
    solve( !ClientKey( $C, pk(x) ) ▶₁ #i )
      case Desktop_Enroll
      solve( !Vault( ~cred, $O, 'legacy' ) ▶₂ #i )
        case Vault_Setup_Legacy
        solve( !KU( sign(<'fill', $C, $O, r>, ~sk) ) @ #vk.10 )
          case Client_Request
          by contradiction /* from formulas */
        next
          case c_sign
          solve( !KU( ~sk ) @ #vk.16 )
            case Corrupt_Client
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

