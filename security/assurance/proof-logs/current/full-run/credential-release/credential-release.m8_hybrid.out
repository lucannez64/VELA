  all-traces
  "∀ c O #i.
    ((Secret( c, O, 'legacy' ) @ #i) ∧
     (¬(∃ C g r #j. Released( C, O, c, g, r ) @ #j))) ⇒
    (¬(∃ #k. K( c ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i.
  (Secret( c, O, 'legacy' ) @ #i)
 ∧
  (∀ C g r #j. (Released( C, O, c, g, r ) @ #j) ⇒ ⊥) ∧
  (∃ #k. (K( c ) @ #k))"
*/
simplify
solve( Secret( c, O, 'legacy' ) @ #i )
  case Vault_Setup_Legacy
  solve( !KU( ~cred ) @ #vk )
    case Desktop_Release
    by contradiction /* from formulas */
  qed
qed

