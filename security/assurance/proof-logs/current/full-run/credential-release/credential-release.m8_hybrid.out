  (Compromised( C2 ) @ #i) ∧ (Released( C, O, c, g, r ) @ #k)
 ∧
  (¬(C = C2)) ∧
  (∀ #h. (Compromised( C ) @ #h) ⇒ ¬(#h < #k)) ∧
  (∀ #j. (ClientRequests( C, O, r ) @ #j) ⇒ ¬(#j < #k))"
*/
simplify
solve( !MyKey( $C, pkey, sk ) ▶₀ #i )
  case Client_Join
  solve( Grant( $C.1, $O, c, g ) ▶₀ #k )
    case Human_Approve
    solve( !ClientKey( $C.1, pk(x) ) ▶₁ #k )
      case Desktop_Enroll
      solve( !Vault( ~cred, $O, 'legacy' ) ▶₂ #k )
        case Vault_Setup_Legacy
        solve( !KU( sign(<'fill', $C.1, $O, r>, ~sk.1) ) @ #vk.10 )
          case Client_Request
          by contradiction /* from formulas */
        next
          case c_sign
          solve( !KU( ~sk.1 ) @ #vk.16 )
            case Corrupt_Client
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

