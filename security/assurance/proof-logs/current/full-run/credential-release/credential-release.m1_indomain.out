theory M1_InDomain

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred ), Setup( ~cred ) ]->
   [ !Vault( ~cred ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Release_InDomain:
   [ !Vault( cred ), In( <'request', requester> ) ]
  --[ Released( cred, requester ) ]->
   [ Out( cred ) ]

  /* has exactly the trivial AC variant */

lemma secrecy:
  all-traces "∀ c #i. (Secret( c ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c #i. (Secret( c ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( !KU( ~cred ) @ #vk )
  case Release_InDomain
  SOLVED // trace found
qed

/* All wellformedness checks were successful. */

