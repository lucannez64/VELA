theory M4_NaiveBooleanApproval

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred ), Item( ~cred ) ]->
   [ !Vault( ~cred ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve_Bool:
   [ Fr( ~ok ) ]
  --[ ApproveBool( ~ok ) ]->
   [ Out( ~ok ), !BoolGrant( ~ok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Release_Naive:
   [ !Vault( cred ), !BoolGrant( ok ), In( <'request', ok, requester> ) ]
  --[ Released( cred ), UsedGrant( ok ) ]->
   [ Out( cred ) ]

  /* has exactly the trivial AC variant */

lemma unintended_item_leaks:
  exists-trace "∃ c #i #j. (Secret( c ) @ #i) ∧ (K( c ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ c #i #j. (Secret( c ) @ #i) ∧ (K( c ) @ #j)"
*/
simplify
solve( !KU( ~cred ) @ #vk )
  case Release_Naive
  solve( !KU( ~ok ) @ #vk.4 )
    case Human_Approve_Bool
    SOLVED // trace found
  qed
qed

