          qed
        next
          case c_aenc
          solve( !KU( sign(<'vela share item v2', 
                            <S0, dev, pk(x), $B, h(pk(~dk)), lineage0, %1>, item0>,
                           x)
                 ) @ #vk.24 )
            case Sender_FirstSend
            solve( !KU( ~dk ) @ #vk.25 )
              case Reveal_ShareKey
              solve( Pin( ~slot, $B, dk.1, S.1, pk(x), lineage.1, pinned ) ▶₀ #j )
                case Recipient_FirstContact
                by contradiction /* from formulas */
              next
                case Recipient_Update
