lemma updates_strictly_increase_the_revision [use_induction]:
  all-traces
  "∀ slot B S vk lineage rev item S0 vk0 lineage0 old item0 #i #j.
    (((Admitted( slot, B, S0, vk0, lineage0, old, item0 ) @ #i) ∧
      (Applied( slot, B, S, vk, lineage, rev, item ) @ #j)) ∧
     (#i < #j)) ⇒
    (old ⊏ rev)"
/*
guarded formula characterizing all counter-examples:
"∃ slot B S vk lineage rev item S0 vk0 lineage0 old item0 #i #j.
  (Admitted( slot, B, S0, vk0, lineage0, old, item0 ) @ #i) ∧
  (Applied( slot, B, S, vk, lineage, rev, item ) @ #j)
 ∧
  (#i < #j) ∧ (¬(old ⊏ rev))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( Admitted( slot, $B, S0, vk0, lineage0, old, item0 ) @ #i )
    case Recipient_FirstContact
    simplify
    solve( (old = %1)  ∥ (%1 ⊏ old) )
      case case_1
      solve( !ShareKey( $B, dk ) ▶₀ #i )
