              qed
            qed
          next
            case c_sign
            solve( !KU( h(pk(~dk)) ) @ #vk.20 )
              case Sender_FirstSend
              solve( !KU( ~dk ) @ #vk.29 )
                case Reveal_ShareKey
                solve( Pin( ~slot, $B, dk.1, S, pk(x.1), lineage, pinned ) ▶₀ #j )
