                  by contradiction /* from formulas */
                qed
              qed
            next
              case Sender_Update
              solve( (rev.1 = %1)  ∥ (%1 ⊏ rev.1) )
                case case_1
                solve( !KU( ~dk ) @ #vk.30 )
                  case Reveal_ShareKey
