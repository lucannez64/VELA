lemma shared_items_stay_secret [use_induction]:
  all-traces
  "∀ item B ek #i #k.
    ((SecretItem( item, B, ek ) @ #i) ∧ (K( item ) @ #k)) ⇒
    (∃ #r. (ShareKeyRevealed( B, ek ) @ #r) ∧ (#r < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ item B ek #i #k.
  (SecretItem( item, B, ek ) @ #i) ∧ (K( item ) @ #k)
 ∧
  ∀ #r. (ShareKeyRevealed( B, ek ) @ #r) ⇒ ¬(#r < #k)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
