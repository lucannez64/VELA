lemma admitted_items_were_sent_by_the_pinned_device [use_induction]:
  all-traces
  "∀ slot B S vk lineage rev item #i #h.
    ((Admitted( slot, B, S, vk, lineage, rev, item ) @ #i) ∧
     (HonestDeviceKey( S, vk ) @ #h)) ⇒
    ((∃ #j. (Sent( S, vk, B, lineage, rev, item ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (DeviceKeyRevealed( vk ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ slot B S vk lineage rev item #i #h.
  (Admitted( slot, B, S, vk, lineage, rev, item ) @ #i) ∧
  (HonestDeviceKey( S, vk ) @ #h)
 ∧
  (∀ #j. (Sent( S, vk, B, lineage, rev, item ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (DeviceKeyRevealed( vk ) @ #k) ⇒ ¬(#k < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#h))  ∥ (last(#i))  ∥
         (∃ #j.
           (Sent( $S, pk(~sk), B, lineage, rev, item ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i))  ∥
         (∃ #k. (DeviceKeyRevealed( pk(~sk) ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i)) )
    case case_1
    solve( Admitted( slot, B, $S, pk(~sk), lineage, rev, item ) @ #i )
      case Recipient_FirstContact
      by contradiction /* node #i after last node #h */
    next
      case Recipient_Update
      by contradiction /* node #i after last node #h */
    qed
  next
    case case_2
    solve( Admitted( slot, B, $S, pk(~sk), lineage, rev, item ) @ #i )
      case Recipient_FirstContact
      solve( (rev = %1)  ∥ (%1 ⊏ rev) )
        case case_1
        solve( !ShareKey( $B, dk ) ▶₀ #i )
          case Recipient_ShareKey
          solve( !KU( aenc(<'VSE2', 
                            <$S, dev.1, pk(~sk), $B, h(pk(~dk)), lineage, %1>, item, 
                            sign(<'vela share item v2', 
                                  <$S, dev.1, pk(~sk), $B, h(pk(~dk)), lineage, %1>, item>,
                                 ~sk)
                           >,
                           pk(~dk))
                 ) @ #vk.2 )
            case Sender_FirstSend
            by contradiction /* from formulas */
          next
            case Sender_Update
            by contradiction /* from formulas */
          next
            case c_aenc
            solve( !KU( sign(<'vela share item v2', 
                              <$S, dev.1, pk(~sk), $B, h(pk(~dk)), lineage, %1>, item>,
                             ~sk)
                   ) @ #vk.21 )
              case Sender_FirstSend
              by contradiction /* from formulas */
            next
              case Sender_Update
              by contradiction /* from formulas */
            next
              case c_sign
              solve( !KU( ~sk ) @ #vk.24 )
                case Reveal_DeviceKey
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case case_2
        solve( !ShareKey( $B, dk ) ▶₀ #i )
          case Recipient_ShareKey
          solve( !KU( aenc(<'VSE2', 
                            <$S, dev.1, pk(~sk), $B, h(pk(~dk)), lineage, rev>, item, 
                            sign(<'vela share item v2', 
                                  <$S, dev.1, pk(~sk), $B, h(pk(~dk)), lineage, rev>, item>,
                                 ~sk)
                           >,
                           pk(~dk))
                 ) @ #vk.2 )
            case Sender_FirstSend
            by contradiction /* contradictory subterm store */
          next
            case Sender_Update
            by contradiction /* from formulas */
          next
            case c_aenc
            solve( !KU( sign(<'vela share item v2', 
                              <$S, dev.1, pk(~sk), $B, h(pk(~dk)), lineage, rev>, item>,
                             ~sk)
                   ) @ #vk.21 )
              case Sender_FirstSend
              by contradiction /* contradictory subterm store */
            next
              case Sender_Update
              by contradiction /* from formulas */
            next
              case c_sign
              solve( !KU( ~sk ) @ #vk.24 )
                case Reveal_DeviceKey
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    next
      case Recipient_Update
      solve( !KU( aenc(<'VSE2', 
                        <$S, dev.1, pk(~sk), $B, h(pk(dk)), lineage, rev>, item, 
                        sign(<'vela share item v2', 
                              <$S, dev.1, pk(~sk), $B, h(pk(dk)), lineage, rev>, item>,
                             ~sk)
                       >,
                       pk(dk))
             ) @ #vk.2 )
        case Sender_FirstSend
