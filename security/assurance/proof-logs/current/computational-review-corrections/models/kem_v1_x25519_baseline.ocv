(* BASELINE: VELA hybrid KEM combiner v1, same game as kem_v2_x25519_gdh.ocv.

     v1: ss = HKDF(ss_mlkem || ss_x25519)   -- no transcript binding

   Hand argument, under an additional capability: if an adversary can find
   a different ML-KEM ciphertext decapsulating to the challenge ML-KEM secret,
   it can retain the challenge ephemeral key and query the alternative capsule
   to recover the v1 challenge key. Secret-key disclosure alone does not imply
   that ciphertext-collision/second-preimage capability.

   Expected: CryptoVerif does NOT prove the query. This is an unproved-query
   control, not an attack trace or a machine-checked realization of that extra
   capability. Correctness is modelled below; no second-preimage algorithm is.
*)

param Qd.

(* ── X25519 (prime-order abstraction) under GDH ── *)
type Z [large,bounded].
type G [large,bounded].
proba pGDH.
proba pDistRerandom.
expand DH_good_group(G, Z, g, exp, exp', mult).
expand GDH(G, Z, g, exp, exp', mult, pGDH, pDistRerandom).

(* ── ML-KEM: arbitrary, adversary-controlled ── *)
type mlsk [bounded].
type mlpk [bounded].
type mlseed [large,fixed].
type mlct [bounded].
type mlss [bounded].
fun mlpkgen(mlsk): mlpk.
fun mlencap_ct(mlpk, mlseed): mlct.
fun mlencap_ss(mlpk, mlseed): mlss.
fun mldecap(mlct, mlsk): mlss.

(* Leaked-key decapsulation must recover the honest challenge secret too.
   No confidentiality assumption is made about these ML-KEM functions. *)
equation forall sk: mlsk, seed: mlseed;
  mldecap(mlencap_ct(mlpkgen(sk), seed), sk) = mlencap_ss(mlpkgen(sk), seed).

(* ── The combiner: HKDF-SHA256 as a random oracle ── *)
type hashkey [fixed].
type key [large,fixed].
expand ROM_hash_2(hashkey, mlss, G, key, H, Horacle, qH).

query secret b [cv_bit].

process
  Ostart() :=
    hk <-R hashkey;
    b <-R bool;
    skm <-R mlsk;
    x <-R Z;
    (* the ML-KEM secret key is handed to the adversary *)
    return(skm, exp(g, x));
    ((
      Ochall() :=
        s <-R mlseed;
        y <-R Z;
        pkm <- mlpkgen(skm);
        ctm: mlct <- mlencap_ct(pkm, s);
        ssm <- mlencap_ss(pkm, s);
        epk: G <- exp(g, y);
        k0 <- H(hk, ssm, exp(exp(g, x), y));
        k1 <-R key;
        return(ctm, epk, if b then k0 else k1)
    ) | (
      foreach id <= Qd do
      Odecap(ctq: mlct, epkq: G) :=
        find suchthat defined(ctm, epk) && ctq = ctm && epkq = epk then yield else
        return(H(hk, mldecap(ctq, skm), exp(epkq, x)))
    ) | run Horacle(hk))
