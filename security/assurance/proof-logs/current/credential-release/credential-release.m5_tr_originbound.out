theory M5_TargetRedefinition

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Setup_DeviceKey:
   [ Fr( ~sk ) ] --> [ !DevKey( ~sk ), !Pk( pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_OriginBound:
   [ !DevKey( sk ), In( <'auth', origin, chal> ) ]
  --[ Signed( origin, chal ) ]->
   [ Out( sign(<origin, chal>, sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Challenge:
   [ Fr( ~chal ) ]
  --[ Challenge( $O, ~chal ) ]->
   [ Out( <$O, ~chal> ), StRP( $O, ~chal ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Accept:
   [ StRP( O, chal ), !Pk( pkey ), In( sig ) ]
  --[ Accept( O, chal ), Verified( verify(sig, <O, chal>, pkey) ) ]->
   [ ]

  /*
  rule (modulo AC) RP_Accept:
     [ StRP( O, chal ), !Pk( pkey ), In( sig ) ]
    --[ Accept( O, chal ), Verified( z ) ]->
     [ ]
    variants (modulo AC)
    1. O     = O.6
       chal  = chal.6
       pkey  = pkey.6
       sig   = sig.6
       z     = verify(sig.6, <O.6, chal.6>, pkey.6)
    
    2. O     = x.6
       chal  = x.7
       pkey  = pk(x.8)
       sig   = sign(<x.6, x.7>, x.8)
       z     = true
  */

restriction VerifyTrue:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  */

lemma no_cross_origin:
  all-traces
  "∀ O chal #i.
    (Accept( O, chal ) @ #i) ⇒ (∃ #j. (Signed( O, chal ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ O chal #i.
  (Accept( O, chal ) @ #i) ∧ ∀ #j. (Signed( O, chal ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( StRP( O, chal ) ▶₀ #i )
  case RP_Challenge
  solve( !Pk( pk(x) ) ▶₁ #i )
    case Setup_DeviceKey
    solve( !KU( sign(<$O, ~chal>, ~sk) ) @ #vk )
      case Sign_OriginBound
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~sk ) @ #vk.2 )
    qed
  qed
qed

lemma transient_residual:
  exists-trace "∃ O chal #i. Accept( O, chal ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ O chal #i. (Accept( O, chal ) @ #i)"
*/
simplify
solve( StRP( O, chal ) ▶₀ #i )
  case RP_Challenge
  solve( !Pk( pk(x) ) ▶₁ #i )
    case Setup_DeviceKey
    solve( !KU( sign(<$O, ~chal>, ~sk) ) @ #vk )
      case Sign_OriginBound
      solve( !KU( ~chal ) @ #vk.5 )
        case RP_Challenge
        SOLVED // trace found
      qed
    qed
  qed
qed

