     ) | (
       foreach id <= Qd do
       Odecap(ctq: mlct, epkq: G) :=
       if defined(X, ctm) && (ctq = ctm) && (epkq = X) then
         yield
       else
         x_O_3: mlss <- mldecap(ctq, skm);
         find [unique]  suchthat defined(r, X, ssm) && (x_O_3 = ssm) && (epkq = X) then
           return(r)
         orfind u_3 = ri_3 <= Qd suchthat defined(r_1[ri_3], epkq[ri_3], x_O_3[ri_3]) && (x_O_3 = x_O_3[ri_3]) && (epkq = epkq[ri_3]) then
           return(r_1[u_3])
         orfind u_2 = ri_2 <= qH suchthat defined(r_2[ri_2], x2[ri_2], x1[ri_2]) && (x_O_3 = x1[ri_2]) && (x2[ri_2] = exp'(epkq, x)) then
           return(r_2[u_2])
         else
           r_1 <-R key;
           return(r_1)
     ) | (
       foreach iH <= qH do
       OH(x1: mlss, x2: G) :=
       find [unique] u_1 = ri_1 <= Qd suchthat defined(r_1[ri_1], epkq[ri_1], x_O_3[ri_1]) && (x1 = x_O_3[ri_1]) && (x2 = exp'(epkq[ri_1], x)) then
         return(r_1[u_1])
       orfind u = ri <= qH suchthat defined(r_2[ri], x2[ri], x1[ri]) && (x1 = x1[ri]) && (x2 = x2[ri]) then
         return(r_2[u])
       else
         r_2 <-R key;
         return(r_2)
     ))

