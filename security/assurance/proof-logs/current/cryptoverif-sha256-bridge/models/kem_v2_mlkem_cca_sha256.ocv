(* VELA hybrid KEM, combiner v2 — IND-CCA2 from ML-KEM IND-CCA2 and
   the library collision bounds, with the DH secret exponent disclosed and
   SHA-256 over ct_mlkem / pk_mlkem modelled as a collision-resistant hash.

   Code: libVELA/vela-crypto/src/kem.rs (encapsulate, decapsulate, combine_v2).

     ss = HKDF-SHA256(ss_mlkem, ss_x25519, x25519_epk, x25519_pk,
                      SHA-256(ct_mlkem), SHA-256(pk_mlkem))

   This is kem_v2_mlkem_cca.ocv with the SHA-256 bridge machine-checked: the
   random-oracle input contains the two hash outputs, not the raw ciphertext
   and public key. SHA-256 is a fixed (unkeyed) collision-resistant hash
   (CryptoVerif FixedCollisionResistant_hash_1) with explicit collision
   probabilities PhashCt and PhashEk. SHA-256 is public, so the model needs
   no key or hash oracle.

   Assumptions:
   - ML-KEM-1024: IND-CCA2 KEM plus the library's public-key and
     encapsulation-ciphertext collision bounds (IND_CCA2_KEM). Decapsulation may
     fail in the generic model; ML-KEM's implicit rejection never does, which
     is a special case.
   - HKDF-SHA256 over the transcript: a random oracle H.
   - SHA-256: collision resistant on ct_mlkem and pk_mlkem, with
     probabilities PhashCt and PhashEk. This models the two separate
     SHA-256 calls in kem.rs::combine_v2.
   - X25519: NO assumption. The adversary receives the X25519 secret key.

   This is the case where binding the X25519 ephemeral key matters: a
   capsule reusing the challenge ML-KEM ciphertext with a different X25519
   ephemeral key decapsulates the challenge ML-KEM secret, and only the
   transcript binding keeps its derived key independent of the challenge.

   Expected: "All queries proved."
 *)

param Qd.

(* ── X25519 group, no assumption (secret key leaked) ── *)
type Z [large,bounded].
type G [large,bounded].
expand DH_good_group(G, Z, g, exp, exp', mult).

(* ── ML-KEM: IND-CCA2 ── *)
type mlkseed [large,fixed].
type mlpk [bounded].
type mlsk [bounded].
type mlss [large,fixed].
type mlct [bounded].
type mlencout [bounded].
proba Penc.
proba Pkeycoll.
proba Pctxtcoll.
expand IND_CCA2_KEM(mlkseed, mlpk, mlsk, mlss, mlct, mlencout, mlpkgen, mlskgen,
                    mlencap, mlpair, mldecap, mlinjbot, Penc, Pkeycoll, Pctxtcoll).

(* ── SHA-256 over ct_mlkem and pk_mlkem: collision resistant ── *)
type hashout [large,fixed].
proba PhashCt.
proba PhashEk.
expand FixedCollisionResistant_hash_1(mlct, hashout, SHAct, PhashCt).
expand FixedCollisionResistant_hash_1(mlpk, hashout, SHAek, PhashEk).

(* ── The combiner: HKDF-SHA256 as a random oracle ── *)
type hashkey [fixed].
type key [large,fixed].
expand ROM_hash_6(hashkey, mlss, G, G, G, hashout, hashout, key, H, Horacle, qH).

query secret b [cv_bit].

process
  Ostart() :=
    hk <-R hashkey;
    b <-R bool;
    ks <-R mlkseed;
    x <-R Z;
    (* the X25519 secret key is handed to the adversary *)
    return(mlpkgen(ks), x);
    ((
      Ochall() :=
        let mlpair(ssm: mlss, ctm: mlct) = mlencap(mlpkgen(ks)) in
        y <-R Z;
        epk: G <- exp(g, y);
        k0 <- H(hk, ssm, exp(exp(g, x), y), epk, exp(g, x),
               SHAct(ctm), SHAek(mlpkgen(ks)));
        k1 <-R key;
        return(ctm, epk, if b then k0 else k1)
    ) | (
      foreach id <= Qd do
      Odecap(ctq: mlct, epkq: G) :=
        find suchthat defined(ctm, epk) && ctq = ctm && epkq = epk then yield else
        let mlinjbot(ssq: mlss) = mldecap(ctq, mlskgen(ks)) in
        return(H(hk, ssq, exp(epkq, x), epkq, exp(g, x),
                 SHAct(ctq), SHAek(mlpkgen(ks))))
    ) | run Horacle(hk))
