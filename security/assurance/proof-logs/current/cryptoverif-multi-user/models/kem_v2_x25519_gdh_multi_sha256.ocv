(* VELA hybrid KEM, combiner v2 — MULTI-USER, MULTI-CHALLENGE IND-CCA2
   (left-or-right) in a uniform prime-order GDH model with every ML-KEM
   secret key disclosed, and SHA-256 over ct_mlkem / pk_mlkem modelled as
   a collision-resistant hash.

   Code: libVELA/vela-crypto/src/kem.rs (encapsulate, decapsulate,
   combine_v2).  The combiner input is

     ss = HKDF-SHA256(ss_mlkem, ss_x25519, x25519_epk, x25519_pk,
                      SHA-256(ct_mlkem), SHA-256(pk_mlkem))

   (kem.rs:177-192).  Hashing the recipient ML-KEM encapsulation key is
   what separates recipients in the random-oracle input; the single-
   recipient SHA-256 games declare SHAek but never charge PhashEk because
   they never relate two distinct recipient public keys.  This game has N
   honestly generated recipient key pairs and therefore charges PhashEk.

   Game (one global challenge bit b):
   - N honestly generated key pairs.  For each recipient the adversary
     gets pk_i = (mlpkgen(skm_i), exp(g,x_i)) and, on this GDH side, the
     ML-KEM secret key skm_i.  The X25519 exponents x_i remain secret.
   - Up to Qc challenge encapsulations, each addressed by an honest
     recipient public key.  A challenge returns (ctm, epk, key) where
     key = H(...) when b=1 and a fresh random key when b=0.  Qc is the
     total over all recipients; taking Qc = N*Qe covers Qe challenges per
     recipient, and the adversary may put all Qc challenges on one
     recipient.
   - Up to Qd adaptive decapsulation queries per recipient (the
     decapsulation oracle instances are per recipient; #Odecap is the
     total number of calls, bounded by N*Qd).  A query equal to that
     recipient's challenge capsule is rejected, as in IND-CCA2.
   - qH random-oracle queries to H.

   Goal: the challenge bit b is secret.  This is the multi-user,
   multi-challenge, left-or-right IND-CCA2 statement, not a hybrid.

   Assumptions:
   - X25519: Gap Diffie-Hellman in a prime-order group (DH_good_group +
     GDH).  The GDH application is over N static exponents x_i and Qc
     ephemeral exponents y_j, giving the N*Qc factor in the bound.
   - HKDF-SHA256 over the concatenated transcript: a random oracle H.
   - SHA-256: fixed (unkeyed) collision resistance on ct_mlkem and
     pk_mlkem, with probabilities PhashCt and PhashEk.  SHA-256 is public,
     so the model needs no key or hash oracle.
   - ML-KEM: correctness only, no secrecy.  Algorithms are public
     functions with the correctness equation below; every secret key is
     leaked.

   What this model does NOT establish: the concrete X25519 group,
   cofactor-8 and encoding bridges, concrete HKDF/SHA-256 instantiations,
   malicious key generation or adaptive corruptions, and the Rust
   model-to-code correspondence are all outside the machine-checked
   statement.  See the accompanying README.

   Expected: "All queries proved."
 *)

param N.   (* number of honestly generated recipient key pairs *)
param Qc.  (* total challenge encapsulations, any recipients *)
param Qd.  (* decapsulation queries per recipient *)

(* ── X25519 (prime-order abstraction) under GDH ── *)
type Z [large,bounded].
type G [large,bounded].
proba pGDH.
proba pDistRerandom.
expand DH_good_group(G, Z, g, exp, exp', mult).
expand GDH(G, Z, g, exp, exp', mult, pGDH, pDistRerandom).

(* ── ML-KEM: arbitrary, adversary-controlled ── *)
type mlsk [bounded].
type mlpk [bounded].
type mlseed [large,fixed].
type mlct [bounded].
type mlss [bounded].
fun mlpkgen(mlsk): mlpk.
fun mlencap_ct(mlpk, mlseed): mlct.
fun mlencap_ss(mlpk, mlseed): mlss.
fun mldecap(mlct, mlsk): mlss.

(* Leaked-key decapsulation must recover the honest challenge secret too.
   No confidentiality assumption is made about these ML-KEM functions. *)
equation forall sk: mlsk, seed: mlseed;
  mldecap(mlencap_ct(mlpkgen(sk), seed), sk) = mlencap_ss(mlpkgen(sk), seed).

(* ── SHA-256 over ct_mlkem and pk_mlkem: collision resistant ── *)
type hashout [large,fixed].
proba PhashCt.
proba PhashEk.
expand FixedCollisionResistant_hash_1(mlct, hashout, SHAct, PhashCt).
expand FixedCollisionResistant_hash_1(mlpk, hashout, SHAek, PhashEk).

(* ── The combiner: HKDF-SHA256 as a random oracle ── *)
type hashkey [fixed].
type key [large,fixed].
expand ROM_hash_6(hashkey, mlss, G, G, G, hashout, hashout, key, H, Horacle, qH).

(* Challenge capsules are stored per recipient so that decapsulation can
   reject exactly that recipient's challenge capsules. *)
table Chall(N, mlct, G).

query secret b [cv_bit].

process
  Ostart() :=
    hk <-R hashkey;
    b <-R bool;
    return();
    ((
      foreach i <= N do
        Osetup() :=
          skm <-R mlsk;
          x <-R Z;
          (* the ML-KEM secret key is handed to the adversary *)
          return(mlpkgen(skm), exp(g,x), skm);
          (
            foreach id <= Qd do
              Odecap(ctq: mlct, epkq: G) :=
                get Chall(=i, =ctq, =epkq) in yield else
                return(H(hk, mldecap(ctq, skm), exp(epkq, x), epkq, exp(g,x),
                         SHAct(ctq), SHAek(mlpkgen(skm))))
          )
    ) | (
      foreach ie <= Qc do
        Ochall(pkm: mlpk, epkx: G) :=
          find i1 <= N suchthat defined(skm[i1], x[i1])
               && pkm = mlpkgen(skm[i1]) && epkx = exp(g, x[i1]) then (
            s <-R mlseed;
            y <-R Z;
            ctm: mlct <- mlencap_ct(pkm, s);
            ssm <- mlencap_ss(pkm, s);
            epk: G <- exp(g, y);
            k0 <- H(hk, ssm, exp(epkx, y), epk, epkx,
                   SHAct(ctm), SHAek(pkm));
            k1 <-R key;
            insert Chall(i1, ctm, epk);
            return(ctm, epk, if b then k0 else k1)
          ) else (
            yield
          )
    ) | run Horacle(hk))
