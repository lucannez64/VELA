   ]
  --[
  PinObserved( slot, <S, mvk, evk, lineage> ),
  RemoteApplied( slot, B, <S, mvk, evk, lineage>, revision, item, tx, gen )
  ]->
   [
   DiskApplied( slot, B, dk, <S, mvk, evk, lineage>, revision, tx, gen,
                revision, item
   )
