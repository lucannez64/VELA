lemma crash_recovery_and_update_are_reachable [hide_lemma=first_pin_is_unique,
                                               hide_lemma=observed_pin_has_first_contact,
                                               hide_lemma=admission_records_observed_pin]:
  exists-trace
  "∃ slot B S m e lin r1 r2 i1 i2 t1 t2 g1 g2 #h #s1 #s2 #a #b #c #d #f.
    (((((((((((((HonestHybridKey( S, m, e ) @ #h) ∧
                (Sent( S, m, e, B, lin, r1, i1 ) @ #s1)) ∧
               (Sent( S, m, e, B, lin, r2, i2 ) @ #s2)) ∧
              (¬(∃ #x. MlRevealed( m ) @ #x))) ∧
             (¬(∃ #y. EdRevealed( e ) @ #y))) ∧
            (JournalAdmitted( slot, B, <S, m, e, lin>, r1, i1, t1, g1 ) @ #a)) ∧
           (Crash( slot ) @ #b)) ∧
          (RemoteApplied( slot, B, <S, m, e, lin>, r1, i1, t1, g1 ) @ #c)) ∧
         (JournalAdmitted( slot, B, <S, m, e, lin>, r2, i2, t2, g2 ) @ #d)) ∧
        (RemoteApplied( slot, B, <S, m, e, lin>, r2, i2, t2, g2 ) @ #f)) ∧
       (#a < #b)) ∧
      (#b < #c)) ∧
     (#c < #d)) ∧
    (#d < #f)"
/*
guarded formula characterizing all satisfying traces:
"∃ slot B S m e lin r1 r2 i1 i2 t1 t2 g1 g2 #h #s1 #s2 #a #b #c #d #f.
  (HonestHybridKey( S, m, e ) @ #h) ∧
  (Sent( S, m, e, B, lin, r1, i1 ) @ #s1) ∧
  (Sent( S, m, e, B, lin, r2, i2 ) @ #s2) ∧
  (JournalAdmitted( slot, B, <S, m, e, lin>, r1, i1, t1, g1 ) @ #a) ∧
  (Crash( slot ) @ #b) ∧
  (RemoteApplied( slot, B, <S, m, e, lin>, r1, i1, t1, g1 ) @ #c) ∧
  (JournalAdmitted( slot, B, <S, m, e, lin>, r2, i2, t2, g2 ) @ #d) ∧
  (RemoteApplied( slot, B, <S, m, e, lin>, r2, i2, t2, g2 ) @ #f)
 ∧
  (∀ #x. (MlRevealed( m ) @ #x) ⇒ ⊥) ∧
  (∀ #y. (EdRevealed( e ) @ #y) ⇒ ⊥) ∧
  (#a < #b) ∧
  (#b < #c) ∧
  (#c < #d) ∧
  (#d < #f)"
*/
simplify
solve( (r1 = %1)  ∥ (%1 ⊏ r1) )
  case case_1
  solve( (r2 = %1)  ∥ (%1 ⊏ r2) )
    case case_2
    solve( !SigningKeys( $S, device.1, ~ml, ~ed ) ▶₀ #s1 )
      case SenderIdentity
      solve( !RecipientKey( $B, dk.2 ) ▶₁ #s1 )
        case RecipientIdentity
        solve( !SigningKeys( $S, device.1, ~ml, ~ed ) ▶₀ #s2 )
          case SenderIdentity
          solve( !RecipientKey( $B, dk.3 ) ▶₁ #s2 )
            case RecipientIdentity
            solve( !Profile( slot ) ▶₀ #b )
              case NewLocalSlot
              solve( DiskPending( ~slot, $B, dk, <$S, pk(~ml), pk(~ed), lin>, %1, i1,
                                  t1, g1, oldrev, olditem
                     ) ▶₀ #c )
                case FirstJournal
                solve( DiskPending( ~slot, $B, dk.1, <$S, pk(~ml), pk(~ed), lin>, r2, i2,
                                    t2, g2, oldrev, olditem
                       ) ▶₀ #f )
                  case UpdateJournal_case_1
                  solve( JournalAdmitted( ~slot, $B, <$S, pk(~ml), pk(~ed), lin>, %1, i1,
                                          ~tx, 'initial'
                         ) @ #a )
                    case FirstJournal
                    solve( JournalAdmitted( ~slot, $B, <$S, pk(~ml), pk(~ed), lin>, r2, i2,
                                            ~tx.1, successor(gen)
                           ) @ #d )
                      case UpdateJournal
                      solve( DiskClean( ~slot, $B, dk.1, <$S, pk(~ml), pk(~ed), lin>, pinned,
                                        gen, vrev, vitem
                             ) ▶₀ #d )
                        case ClearJournal
                        solve( Snapshot( ~slot, ~tx.1, gen, pinned ) ▶₁ #d )
                          case ReadSnapshot
                          solve( !KU( sign(<'VELA-DSA-v1', 'vela share item v2', 
                                            <$S, device, pk(~ml), pk(~ed), $B, h(pk(~dk)), lin, %1>, i1>,
                                           ~ml)
                                 ) @ #vk.42 )
                            case SenderSend
                            solve( !KU( sign(<'VELA-DSA-v1', 'vela share item v2', 
                                              <$S, device.1, pk(~ml), pk(~ed), $B, h(pk(dk.1)), lin, r2>, i2>,
                                             ~ml)
                                   ) @ #vk.47 )
                              case SenderSend
                              solve( DiskApplied( ~slot, $B, ~dk.1, <$S, pk(~ml), pk(~ed), lin>,
                                                  pinned, tx.2, gen, oldrev, olditem
                                     ) ▶₀ #vr.4 )
                                case PersistVault_case_1
                                solve( DiskApplied( ~slot, B.1, dk.3, <S.1, mvk, evk, lineage>, %1, tx.2,
                                                    'initial', vrev, vitem
                                       ) ▶₀ #vr.6 )
                                  case PersistVault
                                  solve( !KU( ~slot ) @ #vk.37 )
                                    case NewLocalSlot
                                    solve( !KU( ~device ) @ #vk.40 )
                                      case SenderIdentity
                                      solve( !KU( sign(<'vela share item v2', 
                                                        <$S, ~device, pk(~ml), pk(~ed), $B, h(pk(~dk)), lin, 
                                                         %1>, 
                                                        i1>,
                                                       ~ed)
                                             ) @ #vk.45 )
                                        case SenderSend
                                        solve( !KU( sign(<'vela share item v2', 
                                                          <$S, ~device, pk(~ml), pk(~ed), $B, h(pk(~dk)), 
                                                           lin, r2>, 
                                                          i2>,
                                                         ~ed)
                                               ) @ #vk.46 )
                                          case SenderSend
                                          solve( !KU( pk(~ml) ) @ #vk.43 )
                                            case SenderIdentity
                                            solve( !KU( pk(~ed) ) @ #vk.44 )
                                              case SenderIdentity
                                              solve( !KU( h(pk(~dk)) ) @ #vk.46 )
                                                case SenderSend
                                                solve( (revision = %1)  ∥ (%1 ⊏ revision) )
                                                  case case_1
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

