"∃ slot B pin rev item tx gen #i.
  (JournalAdmitted( slot, B, pin, rev, item, tx, gen ) @ #i)
 ∧
  (¬(FirstPinned( slot, pin ) @ #i)) ∧ (¬(PinObserved( slot, pin ) @ #i))"
*/
simplify
solve( JournalAdmitted( slot, B, pin, rev, item, tx, gen ) @ #i )
  case FirstJournal
  by contradiction /* from formulas */
next
  case UpdateJournal
  by contradiction /* from formulas */
qed

lemma journal_preserves_first_pin:
  all-traces
  "∀ slot B pin pin0 rev item tx gen #i #j.
    ((FirstPinned( slot, pin0 ) @ #j) ∧
     (JournalAdmitted( slot, B, pin, rev, item, tx, gen ) @ #i)) ⇒
    (pin = pin0)"
/*
guarded formula characterizing all counter-examples:
"∃ slot B pin pin0 rev item tx gen #i #j.
  (FirstPinned( slot, pin0 ) @ #j) ∧
  (JournalAdmitted( slot, B, pin, rev, item, tx, gen ) @ #i)
 ∧
  ¬(pin = pin0)"
*/
simplify
solve( (FirstPinned( slot, pin ) @ #i)  ∥
       (PinObserved( slot, pin ) @ #i) )
  case case_1
  by contradiction /* from formulas */
next
  case case_2
  by contradiction /* from formulas */
qed

