            qed
          qed
        qed
      next
        case case_2
        solve( (revision.1 = %1)  ∥ (%1 ⊏ revision.1) )
          case case_1
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
