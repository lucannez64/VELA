lemma applied_requires_prior_authenticated_journal:
  all-traces
  "∀ slot B S mvk evk lin rev item tx gen #i.
    (RemoteApplied( slot, B, <S, mvk, evk, lin>, rev, item, tx, gen ) @ #i) ⇒
    (∃ #j.
      (JournalAdmitted( slot, B, <S, mvk, evk, lin>, rev, item, tx, gen
       ) @ #j) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ slot B S mvk evk lin rev item tx gen #i.
  (RemoteApplied( slot, B, <S, mvk, evk, lin>, rev, item, tx, gen ) @ #i)
 ∧
  ∀ #j.
   (JournalAdmitted( slot, B, <S, mvk, evk, lin>, rev, item, tx, gen ) @ #j)
  ⇒
   ¬(#j < #i)"
*/
simplify
solve( DiskPending( slot, B, dk, <S, mvk, evk, lin>, rev, item, tx, gen,
                    oldrev, olditem
       ) ▶₀ #i )
  case FirstJournal
  by contradiction /* from formulas */
next
  case UpdateJournal_case_1
  by contradiction /* from formulas */
next
  case UpdateJournal_case_2
  by contradiction /* from formulas */
qed

lemma first_pin_is_unique [reuse, use_induction]:
  all-traces
  "∀ slot pin1 pin2 #i #j.
    ((FirstPinned( slot, pin1 ) @ #i) ∧ (FirstPinned( slot, pin2 ) @ #j)) ⇒
    ((#i = #j) ∧ (pin1 = pin2))"
/*
guarded formula characterizing all counter-examples:
"∃ slot pin1 pin2 #i #j.
  (FirstPinned( slot, pin1 ) @ #i) ∧ (FirstPinned( slot, pin2 ) @ #j)
 ∧
  ((¬(#i = #j)) ∨ (¬(pin1 = pin2)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (¬(#i = #j))  ∥
         (¬(<S, pk(x), pk(x.1), lineage> = <S.1, pk(x.2), pk(x.3), lineage.1>)) )
    case case_1
    solve( (last(#j))  ∥ (last(#i))  ∥
           ((#i = #j) ∧
            (<S, pk(x), pk(x.1), lineage> = <S.1, pk(x.2), pk(x.3), lineage.1>)) )
      case case_1
      solve( (revision = %1)  ∥ (%1 ⊏ revision) )
        case case_1
        solve( (revision = %1)  ∥ (%1 ⊏ revision) )
          case case_1
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
            solve( DiskEmpty( ~slot, B.1, dk.1 ) ▶₀ #j )
              case NewLocalSlot
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
            solve( DiskEmpty( ~slot, B.1, dk.1 ) ▶₀ #j )
              case NewLocalSlot
