      solve( (revision = %1)  ∥ (%1 ⊏ revision) )
        case case_1
        solve( (revision = %1)  ∥ (%1 ⊏ revision) )
          case case_1
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
            solve( DiskEmpty( ~slot, B.1, dk.1 ) ▶₀ #j )
              case NewLocalSlot
              by contradiction /* from formulas */
            qed
          qed
        next
          case case_2
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
            solve( DiskEmpty( ~slot, B.1, dk.1 ) ▶₀ #j )
              case NewLocalSlot
              by contradiction /* contradictory subterm store */
            qed
          qed
        qed
      next
        case case_2
        solve( (revision.1 = %1)  ∥ (%1 ⊏ revision.1) )
          case case_1
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
            solve( DiskEmpty( ~slot, B.1, dk.1 ) ▶₀ #j )
              case NewLocalSlot
              by contradiction /* contradictory subterm store */
            qed
          qed
        next
          case case_2
          solve( DiskEmpty( slot, B, dk ) ▶₀ #i )
            case NewLocalSlot
            solve( DiskEmpty( ~slot, B.1, dk.1 ) ▶₀ #j )
              case NewLocalSlot
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case case_3
      by contradiction /* from formulas */
    qed
  qed
qed

lemma observed_pin_has_first_contact [reuse, use_induction]:
  all-traces
  "∀ slot pin #i.
    (PinObserved( slot, pin ) @ #i) ⇒
    (∃ #j. (FirstPinned( slot, pin ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ slot pin #i.
  (PinObserved( slot, pin ) @ #i)
 ∧
  ∀ #j. (FirstPinned( slot, pin ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #j. (FirstPinned( slot, pin ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( PinObserved( slot, pin ) @ #i )
      case ClearJournal
      solve( DiskApplied( slot, B, dk, <S, mvk, evk, lineage>, pinned, tx, gen,
                          vrev, vitem
             ) ▶₀ #i )
        case PersistVault_case_1
        by contradiction /* from formulas */
      next
        case PersistVault_case_2
        by contradiction /* from formulas */
      next
        case PersistVault_case_3
        by contradiction /* from formulas */
      qed
    next
      case OpenVault
      solve( DiskClean( slot, B, dk, <S, mvk, evk, lineage>, pinned, gen, vrev,
                        vitem
             ) ▶₀ #i )
        case ClearJournal
        by contradiction /* from formulas */
      next
        case OpenVault
        by contradiction /* from formulas */
      qed
    next
      case PersistVault
      solve( DiskPending( slot, B, dk, <S, mvk, evk, lineage>, revision, item,
                          tx, gen, oldrev, olditem
             ) ▶₀ #i )
        case FirstJournal
        by contradiction /* from formulas */
      next
        case UpdateJournal_case_1
        by contradiction /* from formulas */
      next
        case UpdateJournal_case_2
        by contradiction /* from formulas */
      qed
    next
      case UpdateJournal
      solve( DiskClean( slot, B, dk, <S, pk(x), pk(x.1), lineage>, pinned, gen,
                        vrev, vitem
             ) ▶₀ #i )
        case ClearJournal
        by contradiction /* from formulas */
      next
        case OpenVault
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma admission_records_observed_pin [reuse,
                                      hide_lemma=first_pin_is_unique,
                                      hide_lemma=observed_pin_has_first_contact]:
  all-traces
  "∀ slot B pin rev item tx gen #i.
    (JournalAdmitted( slot, B, pin, rev, item, tx, gen ) @ #i) ⇒
    ((FirstPinned( slot, pin ) @ #i) ∨ (PinObserved( slot, pin ) @ #i))"
