lemma a_generation_commits_at_most_once [use_induction]:
  all-traces
  "∀ slot tx1 tx2 gen o1 n1 p1 o2 n2 p2 #i #j.
    ((JournalDurable( slot, tx1, gen, o1, n1, p1 ) @ #i) ∧
     (JournalDurable( slot, tx2, gen, o2, n2, p2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ slot tx1 tx2 gen o1 n1 p1 o2 n2 p2 #i #j.
  (JournalDurable( slot, tx1, gen, o1, n1, p1 ) @ #i) ∧
  (JournalDurable( slot, tx2, gen, o2, n2, p2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( DiskClean( slot, gen, o1, vrev, vpayload ) ▶₀ #i )
      case ClearJournal
      solve( Chain( slot, successor(gen), o1 ) ▶₁ #i )
        case ClearJournal
        solve( Snapshot( slot, tx1, successor(gen), o1 ) ▶₂ #i )
          case ReadSnapshot
          solve( DiskClean( slot, successor(gen), o2, vrev, vpayload.1 ) ▶₀ #j )
            case ClearJournal
            by contradiction /* cyclic */
          next
            case OpenVault
            solve( Chain( slot, successor(gen), o2 ) ▶₁ #j )
              case PersistJournal
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case PersistJournal
        by contradiction /* cyclic */
      qed
    next
      case Initialize
      solve( Chain( ~slot, 'initial', 'initial' ) ▶₁ #i )
        case Initialize
        solve( Snapshot( ~slot, tx1, 'initial', 'initial' ) ▶₂ #i )
          case ReadSnapshot
          solve( DiskClean( ~slot, 'initial', o2, vrev, vpayload ) ▶₀ #j )
            case Initialize
            by contradiction /* cyclic */
          next
            case OpenVault
            by solve( Chain( ~slot, 'initial', o2 ) ▶₁ #j )
          qed
        qed
      qed
    next
      case OpenVault
      solve( Chain( slot, gen, o1 ) ▶₁ #i )
        case ClearJournal
        solve( Snapshot( slot, tx1, successor(gen), o1 ) ▶₂ #i )
          case ReadSnapshot
          solve( DiskClean( slot, successor(gen), o2, vrev.1, vpayload.1 ) ▶₀ #j )
            case ClearJournal
            solve( Chain( slot, successor(gen), o1 ) ▶₁ #j )
              case PersistJournal
              by contradiction /* cyclic */
            qed
          next
            case OpenVault
            solve( Chain( slot, successor(gen), o2 ) ▶₁ #j )
              case ClearJournal
              by contradiction /* cyclic */
            next
              case PersistJournal
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case Initialize
        solve( Snapshot( ~slot, tx1, 'initial', 'initial' ) ▶₂ #i )
          case ReadSnapshot
          solve( DiskClean( ~slot, 'initial', o2, vrev.1, vpayload.1 ) ▶₀ #j )
            case Initialize
            by solve( Chain( ~slot, 'initial', 'initial' ) ▶₁ #j )
          next
            case OpenVault
            solve( Chain( ~slot, 'initial', o2 ) ▶₁ #j )
              case Initialize
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case PersistJournal
        solve( Snapshot( slot, tx1, successor(gen), o1 ) ▶₂ #i )
          case ReadSnapshot
          by contradiction /* cyclic */
        qed
      qed
    qed
  next
    case case_2
    solve( DiskClean( slot, gen, o1, vrev, vpayload ) ▶₀ #i )
      case ClearJournal
      solve( Chain( slot, successor(gen), o1 ) ▶₁ #i )
        case ClearJournal
        solve( Snapshot( slot, tx1, successor(gen), o1 ) ▶₂ #i )
          case ReadSnapshot
          solve( DiskClean( slot, successor(gen), o2, vrev, vpayload.1 ) ▶₀ #j )
            case ClearJournal
            by contradiction /* cyclic */
          next
            case OpenVault
            solve( Chain( slot, successor(gen), o2 ) ▶₁ #j )
              case PersistJournal
              solve( Snapshot( slot, tx2, successor(gen), o1 ) ▶₂ #j )
                case ReadSnapshot
                by contradiction /* cyclic */
              qed
            qed
          qed
        qed
      next
        case PersistJournal
        by contradiction /* cyclic */
      qed
    next
      case Initialize
      solve( Chain( ~slot, 'initial', 'initial' ) ▶₁ #i )
        case Initialize
        by contradiction /* cyclic */
      qed
    next
      case OpenVault
      solve( Chain( slot, gen, o1 ) ▶₁ #i )
        case ClearJournal
        solve( Snapshot( slot, tx1, successor(gen), o1 ) ▶₂ #i )
          case ReadSnapshot
          solve( DiskClean( slot, successor(gen), o2, vrev.1, vpayload.1 ) ▶₀ #j )
            case ClearJournal
            by contradiction /* cyclic */
          next
            case OpenVault
