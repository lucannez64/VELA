lemma pins_advance_on_every_commit:
  all-traces
  "∀ slot tx gen old next payload #i.
    (JournalDurable( slot, tx, gen, old, next, payload ) @ #i) ⇒
    (old ⊏ next)"
/*
guarded formula characterizing all counter-examples:
"∃ slot tx gen old next payload #i.
  (JournalDurable( slot, tx, gen, old, next, payload ) @ #i)
 ∧
  ¬(old ⊏ next)"
*/
simplify
by contradiction /* from formulas */

lemma recovery_is_reachable:
  exists-trace
  "∃ slot tx gen old next payload #j #c #a #k #o.
    ((((((((JournalDurable( slot, tx, gen, old, next, payload ) @ #j) ∧
           (Crash( slot ) @ #c)) ∧
          (VaultDurable( slot, tx, gen, next, payload ) @ #a)) ∧
         (JournalCleared( slot, tx, gen, next ) @ #k)) ∧
        (Opened( slot, gen, next, next, payload ) @ #o)) ∧
       (#j < #c)) ∧
      (#c < #a)) ∧
     (#a < #k)) ∧
    (#k < #o)"
/*
guarded formula characterizing all satisfying traces:
"∃ slot tx gen old next payload #j #c #a #k #o.
  (JournalDurable( slot, tx, gen, old, next, payload ) @ #j) ∧
  (Crash( slot ) @ #c) ∧
  (VaultDurable( slot, tx, gen, next, payload ) @ #a) ∧
  (JournalCleared( slot, tx, gen, next ) @ #k) ∧
  (Opened( slot, gen, next, next, payload ) @ #o)
 ∧
  (#j < #c) ∧ (#c < #a) ∧ (#a < #k) ∧ (#k < #o)"
*/
simplify
solve( !Profile( slot ) ▶₀ #c )
  case Initialize
  solve( DiskPending( ~slot, tx, successor(gen), next, payload, vrev,
                      vpayload
         ) ▶₀ #a )
    case PersistJournal
    solve( DiskApplied( ~slot, tx, successor(gen), next, intended, vrev.2,
                        vpayload.2
           ) ▶₀ #k )
      case PersistVault
      solve( DiskClean( ~slot, gen, old, vrev.1, vpayload.1 ) ▶₀ #j )
        case Initialize
        solve( Chain( ~slot, 'initial', 'initial' ) ▶₁ #j )
          case Initialize
          solve( Snapshot( ~slot, tx, 'initial', 'initial' ) ▶₂ #j )
            case ReadSnapshot
            solve( Chain( ~slot, successor('initial'), next ) ▶₁ #k )
              case PersistJournal
              solve( DiskClean( ~slot, successor('initial'), next, next, payload
                     ) ▶₀ #o )
                case ClearJournal
                solve( DiskClean( ~slot, 'initial', pinned, vrev, vpayload ) ▶₀ #vr.1 )
                  case Initialize
                  solve( DiskClean( ~slot, 'initial', pinned, vrev, vpayload ) ▶₀ #vr.2 )
                    case Initialize
                    solve( DiskClean( ~slot, 'initial', pinned, vrev, vpayload ) ▶₀ #vr.2 )
                      case Initialize
                      solve( Chain( ~slot, successor('initial'), next ) ▶₁ #vr.2 )
                        case PersistJournal
                        solve( DiskClean( ~slot, 'initial', pinned, vrev, vpayload ) ▶₀ #vr.4 )
                          case Initialize
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

