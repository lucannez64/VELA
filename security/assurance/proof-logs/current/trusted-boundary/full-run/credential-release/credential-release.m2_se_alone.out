theory M2_StorageEscapeAlone

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ), Fr( ~hk ) ]
  --[ Secret( ~cred ), SecretKey( ~hk ) ]->
   [ !Vault( senc(~cred, ~hk) ), !Hw( ~hk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Release_SE_only:
   [ !Vault( ct ), !Hw( hk ), In( <'request', requester> ) ]
  --[ Released( requester ) ]->
   [ Out( sdec(ct, hk) ) ]

  /*
  rule (modulo AC) Release_SE_only:
     [ !Vault( ct ), !Hw( hk ), In( <'request', requester> ) ]
    --[ Released( requester ) ]->
     [ Out( z ) ]
    variants (modulo AC)
    1. ct    = ct.7
       hk    = hk.8
       z     = sdec(ct.7, hk.8)
    
    2. ct    = senc(z.11, hk.8)
       hk    = hk.8
       z     = z.11
  */

lemma hw_key_secret:
  all-traces "∀ k #i. (SecretKey( k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ k #i. (SecretKey( k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)"
*/
simplify
by solve( !KU( ~hk ) @ #vk )

lemma secrecy:
  all-traces "∀ c #i. (Secret( c ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c #i. (Secret( c ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( !KU( ~cred ) @ #vk )
  case Release_SE_only
  SOLVED // trace found
qed

/* All wellformedness checks were successful. */

