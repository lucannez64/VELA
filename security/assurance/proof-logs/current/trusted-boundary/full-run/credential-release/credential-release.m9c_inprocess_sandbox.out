theory M9c_InProcessSandbox

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup_Core:
   [ Fr( ~master ) ]
  --[ CoreStarted( ~master ), MasterKey( ~master ) ]->
   [ !Core( ~master ) ]

  /* has exactly the trivial AC variant */

restriction OneCore:
  "∀ m1 m2 #i #j.
    ((CoreStarted( m1 ) @ #i) ∧ (CoreStarted( m2 ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ m1 m2 #i #j.
    ((CoreStarted( m1 ) @ #i) ∧ (CoreStarted( m2 ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Add_Credential:
   [ !Core( master ), Fr( ~cred ) ]
  --[ Secret( ~cred, $O ) ]->
   [ !Vault( ~cred, $O ), !SiteStore( ~cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Load_Script:
   [ In( script ) ] --[ ScriptLoaded( script ) ]-> [ !Script( script ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve_Login:
   [ !Vault( cred, $O ), Fr( ~g ) ]
  --[ LoginApproved( cred, $O ) ]->
   [ LoginGrant( cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sandbox_Login:
   [
   !Vault( cred, $O ), LoginGrant( cred, $O ), !Script( script ),
   In( <'login', $O, tok> )
   ]
  --[ SandboxSawCred( cred, $O ), LoginPerformed( cred, $O, tok ) ]->
   [ CredToSite( cred, $O, tok ), !Ran( script ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_CheckAndIssue:
   [ !SiteStore( cred, O ), CredToSite( cred, O, tok ), Fr( ~sid ) ]
  --[ SessionIssued( O, ~sid, tok ), LoginOk( cred, O ) ]->
   [ Out( <'session', O, ~sid> ), StSite( O, ~sid, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_Use_Session:
   [ StSite( O, sid, tok ), In( <'use', O, sid> ) ]
  --[ SessionUsed( O, sid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sandbox_Escape:
   [ !Ran( script ), In( <'escape', script> ) ]
  --[ SandboxEscaped( script ) ]->
   [ !Escaped( script ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Escape_Reads_Vault:
   [ !Escaped( script ), !Vault( cred, O ) ]
  --[ Exfiltrated( cred, O ) ]->
   [ Out( cred ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Escape_Reads_Master_Key:
   [ !Escaped( script ), !Core( master ) ]
  --[ ExfiltratedMaster( master ) ]->
   [ Out( master ) ]

  /* has exactly the trivial AC variant */

lemma credential_never_leaks:
  all-traces "∀ c O #i. (Secret( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (Secret( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( !Core( master ) ▶₀ #i )
  case Setup_Core
  solve( !KU( ~cred ) @ #vk )
    case Escape_Reads_Vault
    SOLVED // trace found
  qed
qed

lemma credential_never_leaks_without_escape:
  all-traces
  "∀ c O #i.
    (Secret( c, O ) @ #i) ⇒
    ((∃ s #e. SandboxEscaped( s ) @ #e) ∨ (¬(∃ #j. K( c ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i.
  (Secret( c, O ) @ #i)
 ∧
  (∀ s #e. (SandboxEscaped( s ) @ #e) ⇒ ⊥) ∧ (∃ #j. (K( c ) @ #j))"
*/
simplify
solve( !Core( master ) ▶₀ #i )
  case Setup_Core
  solve( !KU( ~cred ) @ #vk )
    case Escape_Reads_Vault
    by contradiction /* from formulas */
  qed
qed

lemma unused_credentials_stay_secret:
  all-traces
  "∀ c O #i.
    ((Secret( c, O ) @ #i) ∧ (¬(∃ O2 #u. SandboxSawCred( c, O2 ) @ #u))) ⇒
    (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i.
  (Secret( c, O ) @ #i)
 ∧
  (∀ O2 #u. (SandboxSawCred( c, O2 ) @ #u) ⇒ ⊥) ∧ (∃ #j. (K( c ) @ #j))"
*/
simplify
solve( !Core( master ) ▶₀ #i )
  case Setup_Core
  solve( !KU( ~cred ) @ #vk )
    case Escape_Reads_Vault
    SOLVED // trace found
  qed
qed

lemma escape_takes_credentials_never_used:
  exists-trace
  "∃ c O #i #j.
    ((Exfiltrated( c, O ) @ #i) ∧ (K( c ) @ #j)) ∧
    (¬(∃ O2 #u. SandboxSawCred( c, O2 ) @ #u))"
/*
guarded formula characterizing all satisfying traces:
"∃ c O #i #j.
  (Exfiltrated( c, O ) @ #i) ∧ (K( c ) @ #j)
 ∧
  ∀ O2 #u. (SandboxSawCred( c, O2 ) @ #u) ⇒ ⊥"
*/
simplify
solve( !Escaped( script ) ▶₀ #i )
  case Sandbox_Escape
  solve( !Vault( c, O ) ▶₁ #i )
    case Add_Credential
    solve( !KU( ~cred ) @ #vk )
      case Escape_Reads_Vault
      SOLVED // trace found
    qed
  qed
qed

lemma escape_takes_the_master_key:
  exists-trace "∃ m #i #j. (ExfiltratedMaster( m ) @ #i) ∧ (K( m ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ m #i #j. (ExfiltratedMaster( m ) @ #i) ∧ (K( m ) @ #j)"
*/
simplify
solve( !Escaped( script ) ▶₀ #i )
  case Sandbox_Escape
  solve( !Core( m ) ▶₁ #i )
    case Setup_Core
    solve( !KU( ~master ) @ #vk )
      case Escape_Reads_Master_Key
      SOLVED // trace found
    qed
  qed
qed

lemma login_succeeds:
  exists-trace "∃ c O tok #i. LoginPerformed( c, O, tok ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ c O tok #i. (LoginPerformed( c, O, tok ) @ #i)"
*/
simplify
solve( !Vault( c, $O ) ▶₀ #i )
  case Add_Credential
  solve( LoginGrant( ~cred, $O ) ▶₁ #i )
    case Human_Approve_Login
    solve( !Script( script ) ▶₂ #i )
      case Load_Script
      SOLVED // trace found
    qed
  qed
qed

