theory M3_DecisionPlusStorageEscape

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ), Fr( ~hk ) ]
  --[ Secret( ~cred ), Item( ~cred ) ]->
   [ !Vault( ~cred, ~hk ), !Hw( ~hk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve:
   [ !Vault( cred, hk ) ] --[ Approve( cred ) ]-> [ Approved( cred ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Release_DE_SE:
   [
   !Vault( cred, hk ), !Hw( hk ), Approved( cred ),
   In( <'request', requester> )
   ]
  --[ Released( cred, requester ) ]->
   [ Out( cred ) ]

  /* has exactly the trivial AC variant */

lemma secrecy_unused:
  all-traces
  "∀ c #i.
    ((Secret( c ) @ #i) ∧ (¬(∃ #k. Approve( c ) @ #k))) ⇒
    (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c #i.
  (Secret( c ) @ #i)
 ∧
  (∀ #k. (Approve( c ) @ #k) ⇒ ⊥) ∧ (∃ #j. (K( c ) @ #j))"
*/
simplify
solve( !KU( ~cred ) @ #vk )
  case Release_DE_SE
  by contradiction /* from formulas */
qed

lemma used_item_leaks:
  exists-trace
  "∃ c #i #k #j.
    ((Secret( c ) @ #i) ∧ (Approve( c ) @ #k)) ∧ (K( c ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ c #i #k #j. (Secret( c ) @ #i) ∧ (Approve( c ) @ #k) ∧ (K( c ) @ #j)"
*/
simplify
solve( !Vault( ~cred, hk.1 ) ▶₀ #k )
  case Setup
  solve( !KU( ~cred ) @ #vk )
    case Release_DE_SE
    SOLVED // trace found
  qed
qed

