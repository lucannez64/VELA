theory M9b_EngineLogin

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred, $O ) ]->
   [ !Vault( ~cred, $O ), !SiteStore( ~cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve_Login:
   [ !Vault( cred, $O ), Fr( ~g ) ]
  --[ LoginApproved( cred, $O ) ]->
   [ LoginGrant( cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Engine_Login:
   [ !Vault( cred, $O ), LoginGrant( cred, $O ), In( <'login', $O, tok> ) ]
  --[ EngineSawCred( cred, $O ), LoginPerformed( cred, $O, tok ) ]->
   [ Out( cred ), CredToSite( cred, $O, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_CheckAndIssue:
   [ !SiteStore( cred, O ), CredToSite( cred, O, tok ), Fr( ~sid ) ]
  --[ SessionIssued( O, ~sid, tok ), LoginOk( cred, O ) ]->
   [ Out( <'session', O, ~sid> ), StSite( O, ~sid, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_Use_Session:
   [ StSite( O, sid, tok ), In( <'use', O, sid> ) ]
  --[ SessionUsed( O, sid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_Expire_Session:
   [ StSite( O, sid, tok ) ] --[ SessionExpired( O, sid ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma credential_leaks_via_engine:
  exists-trace "∃ c O #i #j. (EngineSawCred( c, O ) @ #i) ∧ (K( c ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ c O #i #j. (EngineSawCred( c, O ) @ #i) ∧ (K( c ) @ #j)"
*/
simplify
solve( !Vault( c, $O ) ▶₀ #i )
  case Setup
  solve( LoginGrant( ~cred, $O ) ▶₁ #i )
    case Human_Approve_Login
    solve( !KU( ~cred ) @ #vk.5 )
      case Engine_Login
      SOLVED // trace found
    qed
  qed
qed

lemma credential_never_leaks:
  all-traces "∀ c O #i. (Secret( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (Secret( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( !KU( ~cred ) @ #vk )
  case Engine_Login
  SOLVED // trace found
qed

lemma presence_residual:
  exists-trace "∃ O sid #i. SessionUsed( O, sid ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ O sid #i. (SessionUsed( O, sid ) @ #i)"
*/
simplify
solve( StSite( O, sid, tok ) ▶₀ #i )
  case Site_CheckAndIssue
  solve( !KU( ~sid ) @ #vk.5 )
    case Site_CheckAndIssue
    SOLVED // trace found
  qed
qed

/* All wellformedness checks were successful. */

