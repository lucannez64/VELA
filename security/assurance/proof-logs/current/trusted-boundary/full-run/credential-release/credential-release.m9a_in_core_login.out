theory M9a_InCoreLogin

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~cred ) ]
  --[ Secret( ~cred, $O ), SiteModeSelected( $O, $P ) ]->
   [ !Vault( ~cred, $O ), !SiteStore( ~cred, $O ), !SiteMode( $O, $P ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approve_Login:
   [ !Vault( cred, $O ), Fr( ~g ) ]
  --[ LoginApproved( cred, $O ) ]->
   [ LoginGrant( cred, $O ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Desktop_Login:
   [ !Vault( cred, $O ), LoginGrant( cred, $O ), In( <'login', $O, tok> ) ]
  --[ LoginPerformed( cred, $O, tok ) ]->
   [ CredToSite( cred, $O, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_CheckAndIssue:
   [ !SiteStore( cred, O ), CredToSite( cred, O, tok ), Fr( ~sid ) ]
  --[ SessionIssued( O, ~sid, tok ), LoginOk( cred, O ) ]->
   [ Out( <'session', O, ~sid> ), StSite( O, ~sid, tok ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_Use_Session:
   [ StSite( O, sid, tok ), In( <'use', O, sid> ) ]
  --[ SessionUsed( O, sid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_Expire_Session:
   [ StSite( O, sid, tok ) ] --[ SessionExpired( O, sid ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Site_Session_Escalate:
   [
   StSite( O, sid, tok ), !SiteMode( O, 'selfserve' ),
   In( <'setcred', O, sid, new> )
   ]
  --[ CredentialRotated( O, new ), AccountTakenOver( O ) ]->
   [ !SiteStore( new, O ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

lemma credential_never_leaks:
  all-traces "∀ c O #i. (Secret( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (Secret( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
by solve( !KU( ~cred ) @ #vk )

lemma used_item_still_secret:
  all-traces "∀ c O #i. (LoginOk( c, O ) @ #i) ⇒ (¬(∃ #j. K( c ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ c O #i. (LoginOk( c, O ) @ #i) ∧ ∃ #j. (K( c ) @ #j)"
*/
simplify
solve( !SiteStore( c, O ) ▶₀ #i )
  case Setup
  solve( CredToSite( ~cred, $O, tok ) ▶₁ #i )
    case Desktop_Login
    by solve( !KU( ~cred ) @ #vk )
  qed
next
  case Site_Session_Escalate
  solve( CredToSite( c, $O, tok ) ▶₁ #i )
    case Desktop_Login
    by solve( !KU( ~cred ) @ #vk )
  qed
qed

lemma session_expiry_is_effective:
  all-traces
  "∀ O sid #i.
    (SessionExpired( O, sid ) @ #i) ⇒
    (¬(∃ #j. (SessionUsed( O, sid ) @ #j) ∧ (#i < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ O sid #i.
  (SessionExpired( O, sid ) @ #i)
 ∧
  ∃ #j. (SessionUsed( O, sid ) @ #j) ∧ #i < #j"
*/
simplify
solve( StSite( O, sid, tok ) ▶₀ #i )
  case Site_CheckAndIssue_case_1
  by solve( StSite( $O, ~sid, tok.1 ) ▶₀ #j )
next
  case Site_CheckAndIssue_case_2
  by solve( StSite( $O, ~sid, tok.1 ) ▶₀ #j )
qed

lemma no_takeover_at_hardened_sites:
  all-traces
  "∀ O #i.
    (AccountTakenOver( O ) @ #i) ⇒
    (∃ #j. SiteModeSelected( O, 'selfserve' ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ O #i.
  (AccountTakenOver( O ) @ #i)
 ∧
  ∀ #j. (SiteModeSelected( O, 'selfserve' ) @ #j) ⇒ ⊥"
*/
simplify
solve( !SiteMode( O, 'selfserve' ) ▶₁ #i )
  case Setup
  by contradiction /* from formulas */
qed

lemma session_in_domain:
  exists-trace "∃ O sid #i. K( <'session', O, sid> ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ O sid #i. (K( <'session', O, sid> ) @ #i)"
*/
simplify
SOLVED // trace found

lemma presence_residual:
  exists-trace "∃ O sid #i. SessionUsed( O, sid ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ O sid #i. (SessionUsed( O, sid ) @ #i)"
*/
simplify
solve( StSite( O, sid, tok ) ▶₀ #i )
  case Site_CheckAndIssue_case_1
  solve( !KU( ~sid ) @ #vk.5 )
    case Site_CheckAndIssue
    SOLVED // trace found
  qed
qed

lemma session_enables_persistent_takeover:
  exists-trace
  "∃ O new #i #j.
    ((AccountTakenOver( O ) @ #i) ∧ (CredentialRotated( O, new ) @ #i)) ∧
    (K( new ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ O new #i #j.
  (AccountTakenOver( O ) @ #i) ∧
  (CredentialRotated( O, new ) @ #i) ∧
  (K( new ) @ #j)"
*/
simplify
solve( !SiteMode( O, 'selfserve' ) ▶₁ #i )
  case Setup
  solve( StSite( $O, sid, tok ) ▶₀ #i )
    case Site_CheckAndIssue_case_1
    solve( !KU( ~sid ) @ #vk.6 )
      case Site_CheckAndIssue
      SOLVED // trace found
    qed
  qed
qed

