lemma sessions_require_a_device_signature_on_the_challenge:
  all-traces
  "∀ U dev ch jti #i.
    (SessionIssued( U, dev, ch, jti ) @ #i) ⇒
    ((∃ #j. (DeviceSignedAuth( dev, ch ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (DeviceKeyRevealed( dev ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U dev ch jti #i.
  (SessionIssued( U, dev, ch, jti ) @ #i)
 ∧
  (∀ #j. (DeviceSignedAuth( dev, ch ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (DeviceKeyRevealed( dev ) @ #k) ⇒ ¬(#k < #i))"
*/
simplify
solve( Challenge( ch ) ▶₁ #i )
  case Server_Challenge
  solve( LookupResult( request, U, dev, pk(x) ) ▶₂ #i )
    case Server_Lookup
    solve( !ServerKey( paseto ) ▶₃ #i )
      case Server_Key
      solve( !KU( sign(<'vela auth challenge v1', ~dev, ~ch>, ~sk) ) @ #vk.4 )
        case Device_SignAuth
        by contradiction /* from formulas */
      next
        case c_sign
        solve( !KU( ~sk ) @ #vk.7 )
          case Reveal_DeviceKey
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma a_challenge_yields_at_most_one_session:
  all-traces
  "∀ U U2 dev dev2 ch jti jti2 #i #j.
    ((SessionIssued( U, dev, ch, jti ) @ #i) ∧
     (SessionIssued( U2, dev2, ch, jti2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ U U2 dev dev2 ch jti jti2 #i #j.
  (SessionIssued( U, dev, ch, jti ) @ #i) ∧
  (SessionIssued( U2, dev2, ch, jti2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Challenge( ch ) ▶₁ #i )
    case Server_Challenge
    solve( LookupResult( request, U, dev, pk(x) ) ▶₂ #i )
      case Server_Lookup
      solve( !ServerKey( paseto ) ▶₃ #i )
        case Server_Key
        solve( Challenge( ~ch ) ▶₁ #j )
          case Server_Challenge
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( Challenge( ch ) ▶₁ #i )
    case Server_Challenge
    solve( LookupResult( request, U, dev, pk(x) ) ▶₂ #i )
      case Server_Lookup
      solve( !ServerKey( paseto ) ▶₃ #i )
        case Server_Key
        solve( Challenge( ~ch ) ▶₁ #j )
          case Server_Challenge
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

