    variants (modulo AC)
    1. ch    = ch.12
       dev   = dev.13
       sig   = sig.16
       vk    = vk.17
       z     = verify(sig.16, <'vela auth challenge v1', dev.13, ch.12>, vk.17)
    
    2. ch    = ch.16
       dev   = dev.17
       sig   = sign(<'vela auth challenge v1', dev.17, ch.16>, x.28)
       vk    = pk(x.28)
       z     = true
  */

restriction SignatureVerifies:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Verified( x ) @ #i) ⇒ (x = true)"
