theory M27_DeviceAuthentication

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

/* looping facts with injective instances: DeviceActive/1 */

rule (modulo E) Server_Key:
   [ Fr( ~paseto ) ] --> [ !ServerKey( ~paseto ), Out( pk(~paseto) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_Device:
   [ Fr( ~sk ), Fr( ~dev ) ]
  --[ Registered( $U, ~dev, pk(~sk) ) ]->
   [
   !DeviceSecret( $U, ~dev, ~sk ), !DeviceRow( $U, ~dev, pk(~sk) ),
   DeviceActive( ~dev ), Out( <~dev, pk(~sk)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Revoke_Device:
   [ DeviceActive( dev ) ] --[ Revoked( dev ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_DeviceKey:
   [ !DeviceSecret( U, dev, sk ) ]
  --[ DeviceKeyRevealed( dev ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_Challenge:
   [ Fr( ~ch ) ]
  --[ ChallengeIssued( ~ch ) ]->
   [ Challenge( ~ch ), Out( ~ch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Device_SignAuth:
   [ !DeviceSecret( U, dev, sk ), In( ch ) ]
  --[ DeviceSignedAuth( dev, ch ) ]->
   [ Out( <dev, ch, sign(<'vela auth challenge v1', dev, ch>, sk)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_Lookup:
   [ !DeviceRow( U, dev, vk ), DeviceActive( dev ), Fr( ~request ) ]
  --[ ActiveDeviceLookup( ~request, dev ) ]->
   [ DeviceActive( dev ), LookupResult( ~request, U, dev, vk ) ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) Server_Verify:
   [
   In( <dev, ch, sig> ), Challenge( ch ),
   LookupResult( request, U, dev, vk ), !ServerKey( paseto ), Fr( ~jti )
   ]
  --[
  Verified( verify(sig, <'vela auth challenge v1', dev, ch>, vk) ),
  SessionIssued( U, dev, ch, ~jti ),
  SessionFromLookup( ~jti, request, dev )
  ]->
   [ Out( sign(<'paseto v4', U, dev, ~jti>, paseto) ) ]

