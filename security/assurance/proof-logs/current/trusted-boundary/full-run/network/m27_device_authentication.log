 ∧
  ¬(#i < #r)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( !DeviceRow( U, dev, vk ) ▶₀ #i )
    case Register_Device
    solve( DeviceActive( ~dev ) ▶₀ #r )
      case Register_Device
      solve( DeviceActive( ~dev ) ▶₁ #i )
        case Server_Lookup
        by contradiction /* cyclic */
      qed
    next
      case Server_Lookup
      solve( DeviceActive( ~dev ) ▶₁ #i )
        case Register_Device
        by contradiction /* cyclic */
      next
        case Server_Lookup
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

