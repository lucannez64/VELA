     ]
    --[ Confirmed( c, $A, ek, vk ), RmsSealedTo( rms, ek ) ]->
     [
     Out( <aenc(rms, ek), 
           sign(<'vela device enrollment v1', ek, vk, aenc(rms, ek)>, skP)>
     )
     ]
  */

rule (modulo E) Join_Adopt:
   [ JoinWaiting( c, skJ, dkJ ), In( aenc(r, pk(dkJ)) ) ]
  --[ Adopted( c, r ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma rms_stays_secret:
  all-traces
  "∀ A rms #i #k. ((RmsCreated( A, rms ) @ #i) ∧ (K( rms ) @ #k)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ A rms #i #k. (RmsCreated( A, rms ) @ #i) ∧ (K( rms ) @ #k)"
*/
simplify
solve( !KU( ~rms ) @ #vk )
  case Primary_Confirm
  by solve( !KU( ~dkJ ) @ #vk.6 )
qed

lemma confirmed_keys_are_the_joining_devices:
  all-traces
  "∀ c A ek vk #i.
    (Confirmed( c, A, ek, vk ) @ #i) ⇒
    (∃ #j. (Claimed( c, ek, vk ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ c A ek vk #i.
  (Confirmed( c, A, ek, vk ) @ #i)
 ∧
  ∀ #j. (Claimed( c, ek, vk ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( PrimaryTurn( c ) ▶₀ #i )
  case Start_Ceremony
  solve( !Primary( $A, skP, rms ) ▶₁ #i )
    case Primary
    solve( JoinScreen( ~c,
                       h(<'vela enrollment device fingerprint v4', vk, ek>)
           ) ▶₃ #i )
      case Join_Claim
      by contradiction /* from formulas */
    qed
  qed
qed

