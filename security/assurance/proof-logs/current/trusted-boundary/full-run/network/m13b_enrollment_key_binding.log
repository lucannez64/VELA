theory M13b_EnrollmentKeyBinding

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, pair/2, pk/1, sign/2, snd/1,
           true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

macros: FP( vk, ek ) =  h(<'vela enrollment device fingerprint v4', vk, 
                           ek>)

rule (modulo E) Primary:
   [ Fr( ~skP ), Fr( ~rms ) ]
  --[ RmsCreated( $A, ~rms ) ]->
   [ !Primary( $A, ~skP, ~rms ), Out( pk(~skP) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Start_Ceremony:
   [ Fr( ~c ) ]
  --[ CeremonyStarted( ~c ) ]->
   [ JoinTurn( ~c ), PrimaryTurn( ~c ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Join_Claim:
   [ JoinTurn( c ), Fr( ~skJ ), Fr( ~dkJ ) ]
  --[ Claimed( c, pk(~dkJ), pk(~skJ) ) ]->
   [
   JoinScreen( c, FP(pk(~skJ), pk(~dkJ)) ), JoinWaiting( c, ~skJ, ~dkJ ),
   Out( <'claim', pk(~dkJ), pk(~skJ)> )
   ]

  /*
  rule (modulo AC) Join_Claim:
     [ JoinTurn( c ), Fr( ~skJ ), Fr( ~dkJ ) ]
    --[ Claimed( c, pk(~dkJ), pk(~skJ) ) ]->
     [
     JoinScreen( c,
                 h(<'vela enrollment device fingerprint v4', pk(~skJ), pk(~dkJ)>)
     ),
     JoinWaiting( c, ~skJ, ~dkJ ), Out( <'claim', pk(~dkJ), pk(~skJ)> )
     ]
  */

rule (modulo E) Primary_Confirm:
   [
   PrimaryTurn( c ), !Primary( $A, skP, rms ), In( <'claim', ek, vk> ),
   JoinScreen( c, FP(vk, ek) )
   ]
  --[ Confirmed( c, $A, ek, vk ), RmsSealedTo( rms, ek ) ]->
   [
   Out( <aenc(rms, ek), 
         sign(<'vela device enrollment v1', ek, vk, aenc(rms, ek)>, skP)>
   )
   ]

  /*
  rule (modulo AC) Primary_Confirm:
     [
     PrimaryTurn( c ), !Primary( $A, skP, rms ), In( <'claim', ek, vk> ),
