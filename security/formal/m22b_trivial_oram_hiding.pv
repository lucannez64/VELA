(* ══════════════════════════════════════════════════════════════════════
   M22b · TRIVIAL-ORAM MODE — whole-tree access pattern.

   At or below TRIVIAL_ORAM_THRESHOLD (4) chunks, every sync downloads and
   re-uploads the entire tree regardless of which chunk the user touched
   (`vela_crypto::oram::use_trivial_oram_with_threshold`, extracted by hax
   into lib.pvl). The server's transcript is therefore *literally
   identical* in both worlds — the strongest form of pattern hiding: not
   merely equivalent, but the same terms in the same order.

   Expected verdict: equivalence is TRUE.

   Concatenated at runner level after:
     security/formal/hax_pv_prelude.pvl
     libVELA/vela-crypto/proofs/proverif/extraction/lib.pvl
   ══════════════════════════════════════════════════════════════════════ *)

type leaf.
type chunkid.
type key.
type tree.

(* the relay channel is `c`, declared by the hax-extracted lib.pvl preamble *)

(* The single tree; its id is public (it rides in the URL). In trivial
   mode the sweep covers the whole tree, so the request does not carry a
   leaf at all — modeled as the whole-tree request shape. *)
free tree_id: tree.
fun get_tree(tree): bitstring [data].
fun put_tree(tree, bitstring): bitstring [data].

fun get_path(leaf): bitstring [data].
fun put_path(leaf, bitstring): bitstring [data].
fun aead_stash(key, bitstring): bitstring.
fun chunk_payload(chunkid): bitstring [private].

(* Chunk ids are known to the server via the sync manifest. *)
free chunkA: chunkid.
free chunkB: chunkid.

equivalence
  (* world A: user opens chunk A; trivial mode sweeps everything *)
  new k: key;
    out(c, get_tree(tree_id));
    in(c, downloadedA: bitstring);
    out(c, put_tree(tree_id, aead_stash(k, downloadedA)))
  (* world B: user opens chunk B; identical sweep *)
  new k: key;
    out(c, get_tree(tree_id));
    in(c, downloadedB: bitstring);
    out(c, put_tree(tree_id, aead_stash(k, downloadedB)))
