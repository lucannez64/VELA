theory M23_SyncAdmission
/*
  Client sync-admission decisions (M23).

  A malicious server can serve chunks stamped with any Lamport clock and
  advertise any account key epoch. The client admits a downloaded chunk only
  when its clock matches the one already recorded for that chunk (older or
  forged clocks have no recorded counterpart), and adopts a new account key
  epoch only when the advertised epoch is exactly the successor of its local
  epoch (`succ(local)`), with the capsule bound to that same transition.

  Successor encoding: epochs are terms over the public `succ` constructor,
  so "exactly local + 1" is structural pattern-matching — no arithmetic.

  Expected verdict: all lemmas VERIFIED.
*/
begin

functions: succ/1

/* A fresh account starts at the base epoch. */
rule AccountSetup:
    [ Fr(~user) ]
  --[ AccountCreated(~user) ]->
    [ LocalEpoch('e0') ]

/* ── Chunk admission ─────────────────────────────────────────────────────── */

/* The server serves a chunk revision stamped with any clock it likes;
   the clock term is adversary-chosen network data. D ranges over accounts. */
rule ServeChunk:
    [ In(clock) ]
  --[ ChunkServed(clock) ]->
    [ AdmissionRequest(clock) ]

/* A chunk is admitted only when this device already recorded exactly that
   clock for it — equal-clock redelivery. Older/forged clocks find no
   matching recording and are refused (no rule exists for them). */
rule AdmitKnownChunk:
    [ AdmissionRequest(C), RecordedClock(C) ]
  --[ ChunkAdmitted(C) ]->
    [ RecordedClock(C) ]

/* The recording itself originates only from a legitimately observed
   revision: the device records a clock after admitting it once. */
rule RecordOnFirstSync:
    [ AdmissionRequest(C) ]
  --[ ChunkAdmitted(C), ClockRecorded(C) ]->
    [ RecordedClock(C) ]

lemma every_admitted_chunk_was_served:
  "All C #i.
     ChunkAdmitted(C) @ i
     ==> Ex #j. ChunkServed(C) @ j & #j < #i"

lemma recorded_clock_fact_comes_from_admission:
  "All C #i.
     RecordedClock(C) @ i
     ==> Ex #k. ChunkAdmitted(C) @ k & #k < #i"

/* A first-sync recording happens in the same admitted step. */
lemma clock_recorded_event_comes_from_admission:
  "All C #i.
     ClockRecorded(C) @ i
     ==> ChunkAdmitted(C) @ i"

/* ── Epoch adoption ladder ───────────────────────────────────────────────── */

/* The server advertises account epochs; the adversary picks the term. */
rule AdvertiseEpoch:
    [ In(E) ]
  --[ EpochAdvertised(E) ]->
    [ !AdvertisedEpoch(E) ]

/* Adoption consumes this device's local epoch token and accepts ONLY the
   exact successor. The capsule's inner epoch and rotation id are bound into
   the event, mirroring plan_epoch_adoption's permit. */
rule AdoptSuccessorEpoch:
    [ !AdvertisedEpoch(succ(L)),
      LocalEpoch(L),
      Fr(~rotid),
      Fr(~rms) ]
  --[ EpochAdopted(L, succ(L), ~rotid, ~rms) ]->
    [ LocalEpoch(succ(L)),
      RetiredLocalEpoch(L) ]

/* ── Safety: the adoption ladder ─────────────────────────────────────────── */

/* An adopted epoch is always exactly the successor of the local epoch the
   device held — rollback (pred), skip (succ ∘ succ), and unrelated epochs
   cannot match the rule's premise. */
lemma adoption_requires_successor_of_local:
  "All L E Rid Rms #i.
     EpochAdopted(L, E, Rid, Rms) @ i
     ==> E = succ(L)"

lemma adopted_epoch_differs_from_retired:
  "All Old New Rid Rms #i #j.
     EpochAdopted(Old, New, Rid, Rms) @ i &
     RetiredLocalEpoch(Old) @ j
     ==> not (Old = New)"

lemma every_adoption_has_an_advertised_epoch:
  "All L E Rid Rms #i.
     EpochAdopted(L, E, Rid, Rms) @ i
     ==> Ex #j. EpochAdvertised(E) @ j & #j < #i"

/* Two successive adoptions chain: the token consumed at i is exactly the
   retired token emitted by the prior transition. */
lemma adopted_epoch_was_never_retired_before:
  "All L E Rid Rms #i.
     EpochAdopted(L, E, Rid, Rms) @ i
     ==> not (Ex #j. RetiredLocalEpoch(L) @ j & #j < #i)"

/* ── Availability ─────────────────────────────────────────────────────────── */

lemma adoption_is_reachable:
  exists-trace
  "Ex L Rid Rms #a #b.
     EpochAdvertised(succ(L)) @ a &
     EpochAdopted(L, succ(L), Rid, Rms) @ b & #a < #b"

end
