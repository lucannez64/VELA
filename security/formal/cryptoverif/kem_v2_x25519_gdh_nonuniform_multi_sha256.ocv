(* VELA hybrid KEM, combiner v2 — MULTI-USER, MULTI-CHALLENGE IND-CCA2
   (left-or-right) in a NONUNIFORM (clamped-style) GDH model with every
   ML-KEM secret key disclosed, and SHA-256 over ct_mlkem / pk_mlkem
   modelled as a collision-resistant hash.

   Code: libVELA/vela-crypto/src/kem.rs (encapsulate, decapsulate,
   combine_v2).  The combiner input is

     ss = HKDF-SHA256(ss_mlkem, ss_x25519, x25519_epk, x25519_pk,
                      SHA-256(ct_mlkem), SHA-256(pk_mlkem))

   (kem.rs:177-192).  This is the multi-user companion of
   kem_v2_x25519_gdh_nonuniform_sha256.ocv: the same nonuniform DH
   macros (DH_basic + DH_proba_collision_minimal + GDH_RSR_minimal from
   CryptoVerif 2.12's HPKE material), but with N honestly generated
   recipient key pairs and Qc challenge encapsulations instead of one.
   Because distinct recipients are related in the random-oracle input,
   the pk-hash collision probability PhashEk is now charged.

   Game (one global challenge bit b):
   - N honestly generated key pairs.  For each recipient the adversary
     gets pk_i = (mlpkgen(skm_i), exp(g,x_i)) and, on this GDH side, the
     ML-KEM secret key skm_i.  The X25519 exponents x_i remain secret.
   - Up to Qc challenge encapsulations, each addressed by an honest
     recipient public key; Qc is the total over all recipients (take
     Qc = N*Qe for Qe per recipient).  A challenge returns
     (ctm, epk, key) with key = H(...) when b=1 and a fresh random key
     when b=0.
   - Up to Qd adaptive decapsulation queries per recipient (#Odecap is
     the total, bounded by N*Qd), rejecting that recipient's challenge
     capsule as in IND-CCA2.
   - qH random-oracle queries.

   Goal: the challenge bit b is secret (multi-user, multi-challenge,
   left-or-right IND-CCA2).

   Curve25519 instantiation (for the derived bound in the README):
   PCollKey = 2^-250 and PDistRerandom = 2^-125 from the HPKE material.
   These values are instantiated in the README, not proved here; the
   model exposes PCollKey and pDistRerandom symbolically.

   What this model does NOT establish: that the Rust implementation
   samples the clamped distribution modelled by PCollKey/PDistRerandom;
   clamping correctness; the cofactor-8 subgroup, non-contributory
   inputs and the kem.rs reject check; X25519 encoding aliases; concrete
   HKDF/SHA-256 instantiations; malicious key generation or adaptive
   corruptions; or the Rust model-to-code correspondence.

   Expected: "All queries proved."
 *)

param N.   (* number of honestly generated recipient key pairs *)
param Qc.  (* total challenge encapsulations, any recipients *)
param Qd.  (* decapsulation queries per recipient *)

type Z [large,bounded,nonuniform].
type G [large,bounded].
proba pGDH.
proba pDistRerandom.
proba PCollKey.

(* The two macro definitions below come from CryptoVerif 2.12
   distribution's examples/hpke/lib.gdh.ocvl (Alwen, Blanchet, Hauck,
   Kiltz, Lipp, Riepel, "Analysing the HPKE Standard", Eurocrypt 2021),
   so that this model is self-contained with the standard library
   default.ocvl.  Some explanatory comments are omitted; the definitions
   are unchanged.  The upstream CeCILL-B license is retained in
   HPKE-LICENSE.txt next to the other cryptoverif models. *)

def DH_proba_collision_minimal(G, Z, g, exp, mult, PCollKey) {

expand DH_basic(G, Z, g, exp, exp', mult).
   (* In some game transformations, exp is rewritten into exp'
      to avoid loops. We do not do that here, so exp' is not used. *)

collision x <-R Z; forall Y: G;
  return(exp(g, x) = Y) <=(PCollKey)=> return(false) if Y independent-of x.

}

def GDH_RSR_minimal(G, Z, g, exp, mult, pGDH, pDistRerandom) {

(* the GDH assumption
    This equivalence says that, when exp(g,a[i]) and exp(g,b[j]) are known to the
    adversary, the adversary can compute exp(g, mult(a[i], b[j])) only with
    negligible probability, even in the presence of a decision DH oracle
    DH(A,B,C) tells whether A = g^a, C = B^a for some a. *)

param na, naeq, naDDH, naDDH1, naDDH2, naDDH3, naDDH4, naDDH5, naDDH6, naDDH7, naDDH8, naDH9,
      nb, nbeq, nbDDH, nbDDH1, nbDDH2, nbDDH3, nbDDH4, nbDDH5, nbDDH6, nbDDH7, nbDDH8, nbDH9.

equiv(gdh(exp))
    foreach ia <= na do a <-R Z; (
      OA() := return(exp(g,a)) |
      foreach iaeq <= naeq do OAeq(m:G) := return(m = exp(g,a)) |
         (* We put the oracle above before ODDHa1, so that ODDHa1 is not used when m' = g,
	    which would lead to additional calls to the DDH oracle when in fact
	    we can simply compare with the public key *)
      foreach iaDDH1 <= naDDH1 do ODDHa1(m:G, m':G) := return(m = exp(m', a)) |
      foreach iaDDH  <= naDDH  do ODDHa(m:G, j<=nb) [useful_change] := return(m = exp(g, mult(b[j], a))) |
      foreach iaDDH8 <= naDDH8 do ODDHa8(m:G,j<=na) [3] := return(m = exp(g,mult(a[j], a))) |
      foreach iaDH9 <= naDH9 do ODHa9(x:Z) [2] := return(exp(g, mult(a, x)))
    ) |
    foreach ib <= nb do b <-R Z; (
      OB() := return(exp(g,b)) |
      foreach ibeq <= nbeq do OBeq(m:G) := return(m = exp(g,b)) |
      foreach ibDDH1 <= nbDDH1 do ODDHb1(m:G, m':G) := return(m = exp(m', b)) |
      foreach ibDDH  <= nbDDH  do ODDHb(m:G, j<=na) := return(m = exp(g, mult(a[j], b))) |
      foreach ibDDH8 <= nbDDH8 do ODDHb8(m:G,j<=nb) [3] := return(m = exp(g,mult(b[j], b))) |
      foreach ibDH9 <= nbDH9 do ODHb9(x:Z) [2] := return(exp(g, mult(b, x)))
    )
<=(pGDH(time + (na + nb + 1 + #ODHa9 + #ODHb9) * time(exp),
         #ODDHa + #ODDHa1 + #ODDHa8 +
         #ODDHb + #ODDHb1 + #ODDHb8)
      + (na + nb) * pDistRerandom)=> [computational]
    foreach ia <= na do a <-R Z [unchanged]; (
      OA() := return(exp(g,a)) |
      foreach iaeq <= naeq do OAeq(m:G) := return(m = exp(g,a)) |
      foreach iaDDH1 <= naDDH1 do ODDHa1(m:G, m':G) := return(m = exp(m', a)) |
      foreach iaDDH <= naDDH do ODDHa(m:G, j<=nb) := return(false) |
      foreach iaDDH8 <= naDDH8 do ODDHa8(m:G,j<=na) [3] := return(m = exp(g,mult(a[j], a))) |
      foreach iaDH9 <= naDH9 do ODHa9(x:Z) := return(exp(g, mult(a, x)))
    ) |
    foreach ib <= nb do b <-R Z [unchanged]; (
      OB() := return(exp(g,b)) |
      foreach ibeq <= nbeq do OBeq(m:G) := return(m = exp(g,b)) |
      foreach ibDDH1 <= nbDDH1 do ODDHb1(m:G, m':G) := return(m = exp(m', b)) |
      foreach ibDDH <= nbDDH do ODDHb(m:G, j<=na) := return(false) |
      foreach ibDDH8 <= nbDDH8 do ODDHb8(m:G,j<=nb) [3] := return(m = exp(g,mult(b[j], b))) |
      foreach ibDH9 <= nbDH9 do ODHb9(x:Z) := return(exp(g, mult(b, x)))
    ).

}

expand DH_proba_collision_minimal(G, Z, g, exp, mult, PCollKey).
expand GDH_RSR_minimal(G, Z, g, exp, mult, pGDH, pDistRerandom).

type mlsk [bounded].
type mlpk [bounded].
type mlseed [large,fixed].
type mlct [bounded].
type mlss [bounded].
fun mlpkgen(mlsk): mlpk.
fun mlencap_ct(mlpk, mlseed): mlct.
fun mlencap_ss(mlpk, mlseed): mlss.
fun mldecap(mlct, mlsk): mlss.

equation forall sk: mlsk, seed: mlseed;
  mldecap(mlencap_ct(mlpkgen(sk), seed), sk) = mlencap_ss(mlpkgen(sk), seed).

type hashout [large,fixed].
proba PhashCt.
proba PhashEk.
expand FixedCollisionResistant_hash_1(mlct, hashout, SHAct, PhashCt).
expand FixedCollisionResistant_hash_1(mlpk, hashout, SHAek, PhashEk).

type hashkey [fixed].
type key [large,fixed].
expand ROM_hash_6(hashkey, mlss, G, G, G, hashout, hashout, key, H, Horacle, qH).

table E(N, mlct, G).

query secret b [cv_bit].

process
  Ostart() :=
    hk <-R hashkey;
    b <-R bool;
    return();
    ((
      foreach i <= N do
        Osetup() :=
          skm <-R mlsk;
          x <-R Z;
          return(mlpkgen(skm), exp(g,x), skm);
          (
            foreach id <= Qd do
              Odecap(ctq: mlct, epkq: G) :=
                get E(=i, =ctq, =epkq) in yield else
                return(H(hk, mldecap(ctq, skm), exp(epkq, x), epkq, exp(g,x),
                         SHAct(ctq), SHAek(mlpkgen(skm))))
          )
    ) | (
      foreach ie <= Qc do
        Ochall(pkm: mlpk, epkx: G) :=
          find i1 <= N suchthat defined(skm[i1], x[i1]) && pkm = mlpkgen(skm[i1]) && epkx = exp(g, x[i1]) then (
            s <-R mlseed;
            y <-R Z;
            ctm: mlct <- mlencap_ct(pkm, s);
            ssm <- mlencap_ss(pkm, s);
            epk: G <- exp(g, y);
            k0 <- H(hk, ssm, exp(epkx, y), epk, epkx, SHAct(ctm), SHAek(pkm));
            k1 <-R key;
            insert E(i1, ctm, epk);
            return(ctm, epk, if b then k0 else k1)
          ) else (
            yield
          )
    ) | run Horacle(hk))
