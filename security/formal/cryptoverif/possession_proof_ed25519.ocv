(* VELA RMS possession proof (v2): unforgeable without the RMS, from Ed25519
   alone, even with the ML-DSA-87 component's derived seed leaked.

   Code: libVELA/vela-crypto/src/recovery.rs (possession_keys,
   rms_possession_commitment, rms_possession_sign, rms_possession_verify).

     ml_seed = KDF("vela rms possession ml-dsa v1", rms)
     ed_seed = KDF("vela rms possession ed25519 v1", rms)
     commitment = (ml_vk(ml_seed), ed_vk(ed_seed))           -- staged on the server
     proof      = hybrid_sign(<"vela recovery possession proof v2", user,
                               recovery_id, challenge, epoch>)

   Assumptions:
   - BLAKE3 derive_key with these two contexts: a random oracle (one per
     context; distinct contexts give independent oracles).
   - Ed25519 keys from the derived seed are ordinary Ed25519 keys, and
     Ed25519 is EUF-CMA (UF_CMA_det_signature).
   - ML-DSA-87: NO assumption. Its derived seed is handed to the adversary.
   - The message encoding is injective (length-prefixed fields); modelled as
     an opaque message the adversary chooses.

   Game: a random RMS; the adversary sees the public commitment and the
   leaked Ed25519 seed, obtains Qs genuine proofs on messages of its choice
   (honest recoveries it observes), and must output a valid proof on a
   message never proved by the client (event forge).
   Mirror of possession_proof_mldsa.ocv. The server's
   single-use challenges and rate limits are separate (Tamarin M14/M18,
   policy crates) and are not needed for unforgeability.

   Expected: "All queries proved."
*)

param Qs.

type rms_t [large,fixed].
type msg [bounded].

(* Ed25519: EUF-CMA, keys from a seed *)
type ed_seed [large,fixed].
type ed_pk [bounded].
type ed_sk [bounded].
type ed_sig [bounded].
proba Ped.
proba Pedcoll.
expand UF_CMA_det_signature(ed_seed, ed_pk, ed_sk, msg, ed_sig,
                            ed_skgen, ed_pkgen, ed_sign, ed_check, Ped, Pedcoll).

(* ML-DSA-87: arbitrary *)
type mldsa_seed [large,fixed].
type mldsa_pk [bounded].
type mldsa_sig [bounded].
type mldsa_rand [large,fixed].
fun mldsa_pkgen(mldsa_seed): mldsa_pk.
fun mldsa_sign_r(msg, mldsa_seed, mldsa_rand): mldsa_sig.
fun mldsa_check(msg, mldsa_pk, mldsa_sig): bool.

(* The two KDF contexts, each a random oracle keyed by the RMS *)
type hashkey [fixed].
expand ROM_hash_1(hashkey, rms_t, mldsa_seed, kdf_ml, kdf_ml_oracle, qKml).
expand ROM_hash_1(hashkey, rms_t, ed_seed, kdf_ed, kdf_ed_oracle, qKed).

event forge.
query event(forge) ==> false.

process
  Ostart() :=
    hk1 <-R hashkey;
    hk2 <-R hashkey;
    rms <-R rms_t;
    ms: mldsa_seed <- kdf_ml(hk1, rms);
    es: ed_seed <- kdf_ed(hk2, rms);
    (* commitment (both public keys) plus the leaked ML-DSA seed *)
    return(mldsa_pkgen(ms), ed_pkgen(es), ms);
    ((
      foreach is <= Qs do
      Oprove(m: msg) :=
        r <-R mldsa_rand;
        return(mldsa_sign_r(m, ms, r), ed_sign(m, ed_skgen(es)))
    ) | (
      Oforge(m': msg, s1: mldsa_sig, s2: ed_sig) :=
        if mldsa_check(m', mldsa_pkgen(ms), s1) && ed_check(m', ed_pkgen(es), s2) then
        find u <= Qs suchthat defined(m[u]) && m' = m[u] then yield else
        event forge
    ) | run kdf_ml_oracle(hk1) | run kdf_ed_oracle(hk2))
