letfun vela_share_policy__send_is_authorized(
         facts : vela_share_policy__t_SendCapsuleFacts
       ) =
       accessor_vela_share_policy__t_SendCapsuleFacts_vela_share_policy__f_sender_authenticated(
         facts
       ) && accessor_vela_share_policy__t_SendCapsuleFacts_vela_share_policy__f_recipient_registered(
         facts
       ) && accessor_vela_share_policy__t_SendCapsuleFacts_vela_share_policy__f_capsule_size_valid(
         facts
       ) && accessor_vela_share_policy__t_SendCapsuleFacts_vela_share_policy__f_inbox_has_capacity(
         facts
       ).

letfun vela_share_policy__plan_send(
         facts : vela_share_policy__t_SendCapsuleFacts
       ) =
       if vela_share_policy__send_is_authorized(facts)
       then (vela_share_policy__SendDecision_Deliver())
       else (vela_share_policy__SendDecision_Reject()).

