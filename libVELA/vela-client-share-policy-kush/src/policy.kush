module share_policy.policy;

// Client share admission policy, written and proved in Kush.
//
// A port of `libVELA/vela-client-share-policy` (Rust + hax + F*), with the
// same types, functions and theorems. Each Rust `hax_lib::ensures` is a Kush
// `ensures` clause here. The compiler proves every clause at every value the
// function returns, with a linear-arithmetic decision procedure whose
// certificates are re-checked by an independent checker
// (`crates/kush/src/facts.rs` in the Kush repository). A function whose
// result can break its clause does not compile.
//
// Callers of a function receive its clauses as facts about the result. The
// negative theorems at the end use that: each one composes
// `plan_share_admission` with `is_admitted` and promises `!result`.
//
// Kush propositions cannot call functions, so a Rust spec predicate such as
// `first_contact_is_admissible(facts)` is written out as its conjunction
// (marked FC, UP and BOUND below). The predicate functions themselves carry
// `result => { .. }` and `!result => { .. }` clauses tying them to those
// conjunctions, which is the Rust definition.

use std.option.Option;

/// What the client observed about one received envelope.
pub struct ShareAdmissionFacts {
    /// The capsule opened under this device's share key, parsed as a v2
    /// envelope, and its signature verified under the key it names.
    pub envelope_authenticated: Bool,
    /// The signed recipient user id is this account, and the signed recipient
    /// key digest is the digest of this device's share key.
    pub addressed_to_recipient: Bool,
    /// The signed sender user id equals the sender the server attributed this
    /// capsule to.
    pub sender_matches_attribution: Bool,
    /// A pin exists for this share (it was accepted earlier).
    pub has_pin: Bool,
    /// The signing key and sender user id equal the pinned ones.
    pub signer_matches_pin: Bool,
    /// The signed lineage id equals the pinned one.
    pub lineage_matches_pin: Bool,
    /// Revision recorded in the pin (ignored without a pin).
    pub pinned_revision: u64,
    /// Revision carried in the signed envelope.
    pub candidate_revision: u64,
}

/// Proof that the policy admitted an envelope. The field is private: only
/// this module can mint one, so callers cannot skip the decision.
pub struct SharePinPermit {
    revision: u64,
}

/// The revision the caller must record in its pin.
pub fn share_permit_revision(permit: SharePinPermit) -> u64 ! {}
    ensures { result == permit.revision }
{
    permit.revision
}

pub enum ShareAdmissionDecision {
    /// Show as a new received share; pin on acceptance.
    AcceptFirstContact(SharePinPermit),
    /// Replace the held copy and advance the pin.
    ApplyUpdate(SharePinPermit),
    Reject,
}

// INITIAL_REVISION is 1: revisions start at 1, zero is never valid. It is
// written as the literal `1` in the conditions below.

/// Conditions shared by both paths.
/// BOUND: authenticated && addressed && sender && candidate_revision >= 1.
pub fn envelope_is_bound(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures result => {
        facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
    }
    ensures !result => {
        !(facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1)
    }
{
    facts.envelope_authenticated
        && facts.addressed_to_recipient
        && facts.sender_matches_attribution
        && facts.candidate_revision >= 1
}

/// FC: !has_pin && BOUND.
pub fn first_contact_is_admissible(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures result => {
        !facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
    }
    ensures !result => {
        !(!facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1)
    }
{
    !facts.has_pin && envelope_is_bound(facts)
}

/// UP: has_pin && BOUND && signer && lineage && candidate > pinned.
pub fn update_is_admissible(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures result => {
        facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
            && facts.signer_matches_pin && facts.lineage_matches_pin
            && facts.candidate_revision > facts.pinned_revision
    }
    ensures !result => {
        !(facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
            && facts.signer_matches_pin && facts.lineage_matches_pin
            && facts.candidate_revision > facts.pinned_revision)
    }
{
    facts.has_pin
        && envelope_is_bound(facts)
        && facts.signer_matches_pin
        && facts.lineage_matches_pin
        && facts.candidate_revision > facts.pinned_revision
}

/// Decide what to do with one received envelope.
///
/// The clauses are the Rust `admission_matches_spec(facts, decision)`. The
/// `Reject` case is split in two clauses (not FC, not UP), which is the same
/// conjunction.
pub fn plan_share_admission(facts: ShareAdmissionFacts) -> ShareAdmissionDecision ! {}
    ensures AcceptFirstContact(permit) => {
        !facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
            && permit.revision == facts.candidate_revision
    }
    ensures ApplyUpdate(permit) => {
        facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
            && facts.signer_matches_pin && facts.lineage_matches_pin
            && facts.candidate_revision > facts.pinned_revision
            && permit.revision == facts.candidate_revision
    }
    ensures Reject => {
        !(!facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1)
    }
    ensures Reject => {
        !(facts.has_pin && facts.envelope_authenticated && facts.addressed_to_recipient
            && facts.sender_matches_attribution && facts.candidate_revision >= 1
            && facts.signer_matches_pin && facts.lineage_matches_pin
            && facts.candidate_revision > facts.pinned_revision)
    }
{
    // The Rust body calls `first_contact_is_admissible` and
    // `update_is_admissible`. Their conditions are written out here because
    // Kush's code generator does not inline calls: this halves the time per
    // decision. The clauses above are proved either way.
    let bound = facts.envelope_authenticated
        && facts.addressed_to_recipient
        && facts.sender_matches_attribution
        && facts.candidate_revision >= 1;
    if !facts.has_pin && bound {
        ShareAdmissionDecision.AcceptFirstContact(SharePinPermit {
            revision: facts.candidate_revision,
        })
    } else if facts.has_pin
        && bound
        && facts.signer_matches_pin
        && facts.lineage_matches_pin
        && facts.candidate_revision > facts.pinned_revision
    {
        ShareAdmissionDecision.ApplyUpdate(SharePinPermit {
            revision: facts.candidate_revision,
        })
    } else {
        ShareAdmissionDecision.Reject
    }
}

pub fn is_admitted(decision: ShareAdmissionDecision) -> Bool ! {}
    ensures result => { decision is AcceptFirstContact || decision is ApplyUpdate }
    ensures !result => { decision is Reject }
{
    match decision {
        ShareAdmissionDecision.Reject => false,
        ShareAdmissionDecision.AcceptFirstContact(_) => true,
        ShareAdmissionDecision.ApplyUpdate(_) => true,
    }
}

/// Decision code used by tests and the benchmark: 0 reject, 1 first
/// contact, 2 update.
pub fn decision_code(decision: ShareAdmissionDecision) -> i64 ! {} {
    match decision {
        ShareAdmissionDecision.AcceptFirstContact(_) => 1,
        ShareAdmissionDecision.ApplyUpdate(_) => 2,
        ShareAdmissionDecision.Reject => 0,
    }
}

/// The permit revision as i64, or -1 for a rejection (as the Rust oracle).
pub fn decision_revision(decision: ShareAdmissionDecision) -> i64 ! {} {
    match decision {
        ShareAdmissionDecision.AcceptFirstContact(permit) => Int.truncate(share_permit_revision(permit)),
        ShareAdmissionDecision.ApplyUpdate(permit) => Int.truncate(share_permit_revision(permit)),
        ShareAdmissionDecision.Reject => -1,
    }
}

// ── Negative theorems ────────────────────────────────────────────────────────
//
// Each takes arbitrary facts, falsifies one required observation, and proves
// that the result is never admitted, as the Rust crate's hax theorems. Kush
// has no struct update syntax, so the changed facts are written out.

/// An envelope whose signature did not verify (or that did not parse as v2 —
/// a legacy unsigned capsule) is never admitted.
pub fn unauthenticated_share_can_be_admitted(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    is_admitted(plan_share_admission(ShareAdmissionFacts {
        envelope_authenticated: false,
        addressed_to_recipient: facts.addressed_to_recipient,
        sender_matches_attribution: facts.sender_matches_attribution,
        has_pin: facts.has_pin,
        signer_matches_pin: facts.signer_matches_pin,
        lineage_matches_pin: facts.lineage_matches_pin,
        pinned_revision: facts.pinned_revision,
        candidate_revision: facts.candidate_revision,
    }))
}

/// A signed envelope addressed to someone else (forwarded or retargeted) is
/// never admitted.
pub fn misaddressed_share_can_be_admitted(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    is_admitted(plan_share_admission(ShareAdmissionFacts {
        envelope_authenticated: facts.envelope_authenticated,
        addressed_to_recipient: false,
        sender_matches_attribution: facts.sender_matches_attribution,
        has_pin: facts.has_pin,
        signer_matches_pin: facts.signer_matches_pin,
        lineage_matches_pin: facts.lineage_matches_pin,
        pinned_revision: facts.pinned_revision,
        candidate_revision: facts.candidate_revision,
    }))
}

/// An envelope whose signed sender differs from the server's attribution is
/// never admitted.
pub fn misattributed_share_can_be_admitted(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    is_admitted(plan_share_admission(ShareAdmissionFacts {
        envelope_authenticated: facts.envelope_authenticated,
        addressed_to_recipient: facts.addressed_to_recipient,
        sender_matches_attribution: false,
        has_pin: facts.has_pin,
        signer_matches_pin: facts.signer_matches_pin,
        lineage_matches_pin: facts.lineage_matches_pin,
        pinned_revision: facts.pinned_revision,
        candidate_revision: facts.candidate_revision,
    }))
}

/// Once pinned, an update signed by any other key is never applied — even if
/// the server vouches for it.
pub fn foreign_signer_update_can_be_applied(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    is_admitted(plan_share_admission(ShareAdmissionFacts {
        envelope_authenticated: facts.envelope_authenticated,
        addressed_to_recipient: facts.addressed_to_recipient,
        sender_matches_attribution: facts.sender_matches_attribution,
        has_pin: true,
        signer_matches_pin: false,
        lineage_matches_pin: facts.lineage_matches_pin,
        pinned_revision: facts.pinned_revision,
        candidate_revision: facts.candidate_revision,
    }))
}

/// Once pinned, an envelope from another lineage (another share by the same
/// sender) never replaces this one.
pub fn cross_lineage_update_can_be_applied(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    is_admitted(plan_share_admission(ShareAdmissionFacts {
        envelope_authenticated: facts.envelope_authenticated,
        addressed_to_recipient: facts.addressed_to_recipient,
        sender_matches_attribution: facts.sender_matches_attribution,
        has_pin: true,
        signer_matches_pin: facts.signer_matches_pin,
        lineage_matches_pin: false,
        pinned_revision: facts.pinned_revision,
        candidate_revision: facts.candidate_revision,
    }))
}

/// Once pinned, a replayed or older revision is never applied.
pub fn stale_revision_update_can_be_applied(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    // Rust: `if candidate > pinned { candidate = pinned }`.
    if facts.candidate_revision > facts.pinned_revision {
        is_admitted(plan_share_admission(ShareAdmissionFacts {
            envelope_authenticated: facts.envelope_authenticated,
            addressed_to_recipient: facts.addressed_to_recipient,
            sender_matches_attribution: facts.sender_matches_attribution,
            has_pin: true,
            signer_matches_pin: facts.signer_matches_pin,
            lineage_matches_pin: facts.lineage_matches_pin,
            pinned_revision: facts.pinned_revision,
            candidate_revision: facts.pinned_revision,
        }))
    } else {
        is_admitted(plan_share_admission(ShareAdmissionFacts {
            envelope_authenticated: facts.envelope_authenticated,
            addressed_to_recipient: facts.addressed_to_recipient,
            sender_matches_attribution: facts.sender_matches_attribution,
            has_pin: true,
            signer_matches_pin: facts.signer_matches_pin,
            lineage_matches_pin: facts.lineage_matches_pin,
            pinned_revision: facts.pinned_revision,
            candidate_revision: facts.candidate_revision,
        }))
    }
}

/// A pinned share is never re-admitted as a first contact (which would let a
/// server reset the pin to a key of its choosing).
pub fn pinned_share_can_restart_as_first_contact(facts: ShareAdmissionFacts) -> Bool ! {}
    ensures { !result }
{
    match plan_share_admission(ShareAdmissionFacts {
        envelope_authenticated: facts.envelope_authenticated,
        addressed_to_recipient: facts.addressed_to_recipient,
        sender_matches_attribution: facts.sender_matches_attribution,
        has_pin: true,
        signer_matches_pin: facts.signer_matches_pin,
        lineage_matches_pin: facts.lineage_matches_pin,
        pinned_revision: facts.pinned_revision,
        candidate_revision: facts.candidate_revision,
    }) {
        ShareAdmissionDecision.AcceptFirstContact(_) => true,
        ShareAdmissionDecision.ApplyUpdate(_) => false,
        ShareAdmissionDecision.Reject => false,
    }
}

// ── Durable sharing state decisions ───────────────────────────────────────
// Called by desktop sharing.rs in the Rust crate. They prove decisions over
// supplied observations, not the disk operations or comparisons supplying
// them. A Rust `result == P` clause is written as `result => { P }` and
// `!result => { !(P) }`.

pub fn initial_acceptance_is_authorized(accepted: Bool, has_pin: Bool, has_payload: Bool) -> Bool ! {}
    ensures result => { !accepted && !has_pin && has_payload }
    ensures !result => { !(!accepted && !has_pin && has_payload) }
{
    !accepted && !has_pin && has_payload
}

/// The Rust `store_generation_matches_spec(current, snapshot, pending, result)`.
pub fn next_store_generation(current: u64, snapshot: u64, pending: Bool) -> Option<u64> ! {}
    ensures Some(next) => {
        current == snapshot && !pending && current < 18446744073709551615
            && next == current + 1 && next > current
    }
    ensures None => { current != snapshot || pending || current == 18446744073709551615 }
{
    if current != snapshot || pending || current == 18446744073709551615 {
        Option.None
    } else {
        // Proved not to overflow, so compiled without a check.
        Option.Some(current + 1)
    }
}

/// The next generation as i64, or -1 for `None` (as the Rust oracle).
pub fn generation_code(result: Option<u64>) -> i64 ! {} {
    match result {
        Option.Some(next) => Int.truncate(next),
        Option.None => -1,
    }
}

pub fn stale_snapshot_can_commit(current: u64, snapshot: u64) -> Bool ! {}
    ensures { !result }
{
    if current == snapshot {
        false
    } else {
        match next_store_generation(current, snapshot, false) {
            Option.Some(_) => true,
            Option.None => false,
        }
    }
}

pub fn pending_commit_can_be_overwritten(current: u64, snapshot: u64) -> Bool ! {}
    ensures { !result }
{
    match next_store_generation(current, snapshot, true) {
        Option.Some(_) => true,
        Option.None => false,
    }
}

pub fn exhausted_generation_can_commit() -> Bool ! {}
    ensures { !result }
{
    match next_store_generation(18446744073709551615, 18446744073709551615, false) {
        Option.Some(_) => true,
        Option.None => false,
    }
}

pub fn recovery_should_apply(matches_before: Bool, current_present: Bool, tombstoned: Bool) -> Bool ! {}
    ensures result => { matches_before && (current_present || !tombstoned) }
    ensures !result => { !(matches_before && (current_present || !tombstoned)) }
{
    matches_before && (current_present || !tombstoned)
}

pub fn local_edit_can_be_overwritten(current_present: Bool, tombstoned: Bool) -> Bool ! {}
    ensures { !result }
{
    recovery_should_apply(false, current_present, tombstoned)
}

pub fn deleted_item_can_be_restored(matches_before: Bool) -> Bool ! {}
    ensures { !result }
{
    recovery_should_apply(matches_before, false, true)
}

pub fn existing_pin_can_restart_acceptance(accepted: Bool, has_payload: Bool) -> Bool ! {}
    ensures { !result }
{
    initial_acceptance_is_authorized(accepted, true, has_payload)
}

pub fn missing_payload_can_be_accepted(accepted: Bool, has_pin: Bool) -> Bool ! {}
    ensures { !result }
{
    initial_acceptance_is_authorized(accepted, has_pin, false)
}
