<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
    Lets the user pick an app to link a login to, and lets us show a link's real
    name and icon instead of a bare package name. Scoped to apps with a launcher
    icon on purpose: QUERY_ALL_PACKAGES would let a password manager enumerate
    every package on the device, which it has no business doing, and the apps a
    user would knowingly grant a credential to all have one.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VelaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VELA">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VelaCaptureActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.VELA" />

        <service
            android:name=".autofill.VelaAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!--
        The system-wide passkey provider (security/passkey-android-provider-adr.md).
        The platform binds this when any app or browser asks Credential Manager
        for a passkey; VELA answers with a PendingIntent into its own prompt
        screen, so every ceremony runs behind VELA's approval UI. Additive: the
        autofill service above is untouched.
        -->
        <service
            android:name=".security.passkey.VelaCredentialProviderService"
            android:exported="true"
            android:label="@string/passkey_provider_label"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_capabilities" />
        </service>

        <!-- Launched only through the provider's own PendingIntent: never exported. -->
        <activity
            android:name=".security.passkey.PasskeyPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.VELA" />

        <!-- Enforces the auto-lock deadline while the app is backgrounded. -->
        <receiver
            android:name=".security.AutoLockReceiver"
            android:exported="false" />
    </application>
</manifest>
