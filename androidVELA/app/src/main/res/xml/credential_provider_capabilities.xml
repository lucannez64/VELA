<?xml version="1.0" encoding="utf-8"?>
<!--
  Capabilities of the system-wide passkey provider
  (security/passkey-android-provider-adr.md). VELA serves public-key
  credentials only. The framework's parser (CredentialProviderInfoFactory)
  requires a <credential-provider> root element and the framework credential
  type names — a malformed file yields a provider with no capabilities, which
  Settings then never lists.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
