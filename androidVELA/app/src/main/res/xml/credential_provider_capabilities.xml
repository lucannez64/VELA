<?xml version="1.0" encoding="utf-8"?>
<!--
  Capabilities of the system-wide passkey provider
  (security/passkey-android-provider-adr.md). VELA serves public-key
  credentials only; adding a capability here tells Credential Manager which
  requests may reach the provider service.
-->
<capabilities xmlns:android="http://schemas.android.com/apk/res/android">
    <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
</capabilities>
