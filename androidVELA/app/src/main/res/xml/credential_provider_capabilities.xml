<?xml version="1.0" encoding="utf-8"?>
<!--
  Capabilities of the system-wide passkey provider
  (security/passkey-android-provider-adr.md).

  The platform matches these strings verbatim against the requested
  credential type, and the two spellings are asymmetric (see androidx
  PublicKeyCredential / PasswordCredential): passkey requests carry
  "androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" while password requests
  carry "android.credentials.TYPE_PASSWORD_CREDENTIAL". Declaring both
  spellings of the public-key type keeps the provider discoverable across
  framework versions; the parser treats unknown names as opaque strings.

  The <credential-provider> root element is required — the parser
  (CredentialProviderInfoFactory) refuses anything else and the provider
  ends up with no capabilities at all.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
        <capability name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
